# Cloudflare Pages: /data/* is always served from GitHub raw — Actions commits
# fresh data daily; a static snapshot would go stale between redeploys.
# Pages evaluates _redirects before static assets, so these win even though
# (small) copies exist in the upload. raw.githubusercontent.com sends ACAO:*.
/data/* https://raw.githubusercontent.com/zalize-com/trendscope/main/data/:splat 302
# Repo-generated files (feed.py/gen_opml.py run daily in Actions) — same
# freshness reason as /data/*.
/feed.xml https://raw.githubusercontent.com/zalize-com/trendscope/main/feed.xml 302
/trendscope.opml https://raw.githubusercontent.com/zalize-com/trendscope/main/trendscope.opml 302
/llms.txt https://raw.githubusercontent.com/zalize-com/trendscope/main/llms.txt 302
/docs/api/series.json https://raw.githubusercontent.com/zalize-com/trendscope/main/docs/api/series.json 302
