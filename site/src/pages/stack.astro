---
import Base from "../layouts/Base.astro";
const title = "the stack \u2014 trendscope";
const description = "Every library trendscope runs on \u2014 reused wheels, not hand-rolled.";
const path = '/stack.html';
---
<Base title={title} description={description} path={path} nav="none">

<nav><a href="index.html">← board</a> · <a href="about.html">about</a> · <a href="api.html">api</a></nav>
<h1>the <span style="color:var(--acc)">stack</span></h1>
<p class="sub">Don't reinvent wheels — this site runs on <b>11 CDN libraries</b> loaded from jsdelivr/unpkg, plus hand-rolled code only where no wheel fits. No bundler, no build step, no framework: view-source is the source.</p>

<h2>libraries in use</h2>
<table id="t">
<tr><th>library</th><th>version</th><th>where</th><th>replaces</th></tr>
</table>

<h2>philosophy</h2>
<ul>
<li><b>Reuse first</b> — charting, markdown, diffs, CSV, cron, dates, icons are solved problems. We load the standard wheel and move on.</li>
<li><b>Indie-lightweight</b> — same stack pattern as mainstream indie products: static HTML + CDN scripts + fetch(). No node_modules, no transpile, no framework runtime.</li>
<li><b>Hand-roll only the edge</b> — the aggregation pipeline, dedupe, scoring, and per-page glue are ours; everything else is a wheel.</li>
<li><b>Pinned versions</b> — every dependency is version-pinned except <code>lucide@latest</code> (icon set is append-only).</li>
</ul>

<h2>cdn summary</h2>
<p id="sum" class="sub"></p>

<script is:inline src="/js/pages/stack.js"></script>

<footer style="margin-top:30px;color:var(--dim);font-size:12px;border-top:1px solid var(--line);padding-top:10px">
trendscope · <a href="index.html">board</a> · <a href="press-kit.html">press kit</a> · <a href="https://github.com/zalize-com/trendscope">source</a>
</footer>

</Base>

<style is:global>
:root{--bg:#fff;--fg:#1f2328;--dim:#57606a;--line:#d8dee4;--acc:#0969da;--hot:#cf222e}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme]) { --bg:#0d1117;--fg:#e6edf3;--dim:#8b949e;--line:#30363d;--acc:#58a6ff;--hot:#f85149 }
}
html[data-theme="dark"] { --bg:#0d1117;--fg:#e6edf3;--dim:#8b949e;--line:#30363d;--acc:#58a6ff;--hot:#f85149 }
body{margin:0;padding:16px;background:var(--bg);color:var(--fg);font:14px/1.55 ui-monospace,SFMono-Regular,Menlo,monospace}
  body > :not(.topbar):not(.skiplink) { max-width: 760px; margin-left: auto; margin-right: auto; }
a{color:var(--acc);text-decoration:none}
h1{font-size:22px;margin:4px 0}
h2{font-size:15px;margin:20px 0 6px}
.sub{color:var(--dim);font-size:13px;margin-bottom:14px}
nav{font-size:13px;margin:8px 0 14px}
nav a{margin-right:8px}
table{border-collapse:collapse;width:100%;font-size:13px}
td,th{border-bottom:1px solid var(--line);padding:6px 8px;text-align:left;vertical-align:top}
th{color:var(--dim);font-weight:normal;font-size:11px;text-transform:uppercase}
code{background:var(--bg);border:1px solid var(--line);border-radius:4px;padding:0 4px;font-size:12px}
.tag{display:inline-block;border:1px solid var(--line);border-radius:10px;padding:0 7px;font-size:11px;color:var(--dim)}

  /* a11y floor: focus ring + reduced motion (hallmark-style audit 2026-11-16) */
  :focus-visible { outline: 2px solid var(--accent, #58a6ff); outline-offset: 2px; }
</style>
