---
import Base from "../layouts/Base.astro";
const title = "\u4e2d\u6587 \u00b7 trendscope";
const description = "\u4e2d\u6587\u5f00\u53d1\u8005\u6ce8\u610f\u529b\u2014\u201453 \u4e2a\u4e2d\u6587\u6280\u672f\u6e90\u7684\u5f53\u65e5\u6df7\u6392\uff1a\u91cf\u5b50\u4f4d\u3001\u673a\u5668\u4e4b\u5fc3\u3001ByteByteGo \u4e2d\u6587\u3001\u5b57\u8282/\u7f8e\u56e2/\u817e\u8baf\u6280\u672f\u56e2\u961f\u3001wechat2rss \u516c\u4f17\u53f7\u955c\u50cf\u3001\u4e2d\u6587\u72ec\u7acb\u535a\u5ba2\u3002";
const path = '/zh.html';
---
<Base title={title} description={description} path={path} nav="none">

<div class="wrap">
  <nav><a href="index.html">trendscope</a> · <a href="about.html">about</a> · <a href="datasets.html">datasets</a> · <a href="trendscope.opml">OPML</a></nav>
  <h1>中文<em>开发者注意力</em></h1>
  <p class="muted">53 个中文技术源的当日混排 — 量子位 · 机器之心 · 新智元 · PaperWeekly · Datawhale · HuggingFace 中文 ·
    字节/小米/得物/爱奇艺/百度安全/腾讯/阿里/B站技术（wechat2rss 公众号镜像）· 宝玉 · 李继刚 · 傅盛 · 歸藏 等独立博客。
    全部源打包在 <a href="trendscope.opml">OPML</a> 里可一键导入。</p>
  <div class="grid" id="srcs"></div>
  <div id="board"><p class="muted">loading…</p></div>
  
</div>

<script is:inline src="/js/pages/zh.js"></script>

</Base>

<style is:global>
:root { --bg:#0d1117; --fg:#e6edf3; --mut:#8b949e; --card:#161b22; --line:#30363d; --acc:#58a6ff; }
  @media (prefers-color-scheme: light) {
    :root:not([data-theme]) { --bg:#f6f8fa; --fg:#1f2328; --mut:#59636e; --card:#ffffff; --line:#d0d7de; --acc:#0969da; }
  }
  body { margin:0; background:var(--bg); color:var(--fg);
         font:15px/1.55 -apple-system,BlinkMacSystemFont,"Segoe UI",Helvetica,Arial,sans-serif; }
  .wrap { max-width:880px; margin:0 auto; padding:32px 20px 64px; }
  h1 { font-size:26px; margin:0 0 6px; }
  h1 em { font-style:normal; color:var(--acc); }
  nav { margin-bottom:18px; font-size:14px; }
  .muted { color:var(--mut); font-size:13.5px; margin-bottom:20px; }
  a { color:var(--acc); text-decoration:none; }
  a:hover { text-decoration:underline; }
  .row { display:flex; gap:10px; padding:8px 4px; border-bottom:1px solid var(--line); align-items:baseline; }
  .row .rank { color:var(--mut); font-size:12px; width:22px; text-align:right; flex:none; }
  .row .meta { display:block; font-size:12px; color:var(--mut); margin-top:2px; }
  .src { color:var(--acc); font-size:11.5px; font-weight:600; }
  .grid { display:flex; flex-wrap:wrap; gap:6px; margin:14px 0 22px; }
  .chip { padding:3px 9px; border:1px solid var(--line); border-radius:20px; font-size:12px; color:var(--mut); }
  footer { margin-top:28px; color:var(--mut); font-size:12.5px; }
  :focus-visible { outline:2px solid var(--acc); outline-offset:2px; }
</style>
