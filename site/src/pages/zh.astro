---
import Base from "../layouts/Base.astro";
const title = "中文 · trendscope";
const description = "中文开发者注意力——53 个中文技术源的当日混排：量子位、机器之心、ByteByteGo 中文、字节/美团/腾讯技术团队、wechat2rss 公众号镜像、中文独立博客。";
const path = '/zh.html';
---
<Base title={title} description={description} path={path} nav="zh">

<div class="wrap">
  <header class="hero" style="padding-top:8px;text-align:left">
    <h1 style="font-size:34px">中文<em class="scope">开发者注意力</em></h1>
    <p class="tagline" style="font-size:15px;color:var(--dim);font-weight:400;max-width:64ch">53 个中文技术源的当日混排 — 量子位 · 机器之心 · 新智元 · PaperWeekly · Datawhale · HuggingFace 中文 ·
    字节/小米/得物/爱奇艺/百度安全/腾讯/阿里/B站技术（wechat2rss 公众号镜像）· 宝玉 · 李继刚 · 傅盛 · 歸藏 等独立博客。</p>
    <p style="margin-top:12px;font-size:13px">
      <a class="btn" style="margin-top:0" href="trendscope.opml">订阅全部源（OPML）</a>
      <a class="btn ghost" style="margin-top:0;margin-left:8px" href="index.html">英文主榜 →</a>
    </p>
  </header>

  <section>
    <h2 style="font-size:17px">今日有货的源</h2>
    <div class="zh-grid" id="srcs"></div>
  </section>

  <section>
    <h2 style="font-size:17px">当日混排</h2>
    <div class="board" id="board"><p class="muted" style="padding:14px 16px">loading…</p></div>
  </section>

  <footer>trendscope · the developer attention dataset · <a href="index.html">main board →</a></footer>
</div>

<script is:inline src="/js/pages/zh.js"></script>

</Base>

<style is:global>
  .zh-grid { display:flex; flex-wrap:wrap; gap:6px; }
  .zh-grid .chip { padding:4px 10px; }
  .zh-grid .chip b { color:var(--accent); font-weight:650; margin-left:3px; }
  #board .row { grid-template-columns: 28px 1fr; }
  #board .row .meta { margin-top: 2px; }
</style>
