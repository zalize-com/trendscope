---
import Base from "../layouts/Base.astro";
const title = "RSS feed directory \u2014 trendscope";
const description = "Every RSS/Atom feed behind the trendscope dataset, browsable and searchable: 9,200+ developer blogs, newsletters, security blogs, engineering blogs and YouTube channels. Copy a URL, take a lane OPML, or take the whole OPML.";
const path = '/feeds.html';
const jsonld = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "trendscope RSS feed directory",
  "description": description,
  "isPartOf": {"@type": "WebSite", "name": "trendscope"},
};
---
<Base title={title} description={description} path={path} nav="none" jsonld={jsonld}>

<nav><a href="index.html">← trendscope</a> · <a href="sources.html">sources</a> · <a href="datasets.html">datasets</a> · <a href="trendscope.opml">opml</a></nav>
  <h1>RSS feed <span>directory</span></h1>
  <p class="sub">Every feed behind the dataset — search it, browse by lane, copy a URL into your reader,
    or grab the whole thing as <a href="trendscope.opml" style="font-weight:600">trendscope.opml</a> (CC0).
    Machine-readable: <a href="data/feeds.json" style="color:var(--accent)">↓ feeds.json</a></p>
  <div class="stats" id="stats"></div>
  <input id="q" type="search" placeholder="search 9,200+ feeds — try 'rust', 'ai', 'security'…" autocomplete="off">
  <div id="out"><p id="err">loading…</p></div>

<script is:inline src="/js/pages/feeds.mjs" type="module"></script>

<footer>Open data, <a href="https://creativecommons.org/publicdomain/zero/1.0/">CC0</a> ·
    <a href="https://github.com/zalize-com/trendscope">github.com/zalize-com/trendscope</a></footer>

</Base>

<style is:global>
@media (prefers-color-scheme:dark){:root{ --bg:#0d1117; --fg:#e6edf3; --dim:#8b949e; --border:#21262d; --accent:#58a6ff;
          --green:#3fb950; --orange:#d29922; }}
  body { background: var(--bg); color: var(--fg);
         font: 14px/1.55 -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
         max-width: 860px; margin: 0 auto; padding: 28px 18px 60px; }
  a { color: var(--accent); text-decoration: none; } a:hover { text-decoration: underline; }
  nav a { color: var(--dim); font-size: 13px; }
  h1 { font-size: 26px; margin: 14px 0 4px; } h1 span { color: var(--accent); }
  .sub { color: var(--dim); margin-bottom: 18px; }
  .stats { display: flex; gap: 18px; flex-wrap: wrap; margin: 10px 0 6px; }
  .stat b { font-size: 22px; } .stat small { color: var(--dim); display: block; font-size: 11px; }
  #q { width: 100%; box-sizing: border-box; padding: 9px 12px; margin: 10px 0 14px;
       background: transparent; color: var(--fg); border: 1px solid var(--border); border-radius: 8px;
       font: inherit; }
  #q:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
  details { border: 1px solid var(--border); border-radius: 8px; margin: 6px 0; }
  summary { cursor: pointer; padding: 9px 12px; font-weight: 600; user-select: none; }
  summary small { color: var(--dim); font-weight: 400; margin-left: 8px; }
  .lane-opml { margin: 0; padding: 0 12px 4px; font-size: 12px; }
  details ul { list-style: none; margin: 0; padding: 0 12px 10px; }
  li.feed { display: flex; gap: 8px; padding: 4px 0; border-top: 1px solid var(--border); align-items: baseline; }
  li.feed a { color: var(--fg); } li.feed a:hover { color: var(--accent); }
  li.feed .host { color: var(--dim); font-size: 11px; font-family: ui-monospace, monospace;
                  overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .acts { margin-left: auto; white-space: nowrap; font-size: 12px; }
  .copy { cursor: pointer; color: var(--dim); background: none; border: none; font: inherit; font-size: 12px; padding: 0 4px; }
  .copy:hover { color: var(--accent); }
  .chip { display:inline-block; padding:1px 7px; border:1px solid var(--border); border-radius:10px; font-size:10px; color:var(--dim); margin-left:6px; }
  #err { color: var(--dim); }
  footer { margin-top: 40px; padding-top: 16px; border-top: 1px solid var(--border); color: var(--dim); font-size: 12px; }
  :focus-visible { outline: 2px solid var(--accent, #58a6ff); outline-offset: 2px; }
</style>
