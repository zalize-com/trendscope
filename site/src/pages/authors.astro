---
import Base from "../layouts/Base.astro";
const title = "authors \u2014 trendscope";
const description = "Who keeps shipping things developers care about: most-featured authors across the trendscope daily snapshots.";
const path = '/authors.html';
---
<Base title={title} description={description} path={path} nav="none">

<nav><a href="index.html">← trendscope</a> · <a href="domains.html">domains</a> · <a href="streaks.html">streaks</a></nav>
  <h1>auth<span>ors</span></h1>
  <p class="sub">Most-featured authors &amp; orgs across daily snapshots — grouped by <code>author</code> from <code>data/history.csv</code> · <a href="docs/api/authors.json">↓ json</a></p>
  <div id="out"><p id="err">loading…</p></div>

<script is:inline src="/js/pages/authors.mjs" type="module"></script>

<footer>Open data, <a href="https://creativecommons.org/publicdomain/zero/1.0/">CC0</a> ·     <a href="https://github.com/zalize-com/trendscope">github.com/zalize-com/trendscope</a></footer>

</Base>

<style is:global>
@media (prefers-color-scheme: dark) {
  :root:not([data-theme]) { --bg:#0d1117; --panel:#161b22; --border:#30363d; --fg:#e6edf3;
          --dim:#8b949e; --accent:#58a6ff; }
}
html[data-theme="dark"] { --bg:#0d1117; --panel:#161b22; --border:#30363d; --fg:#e6edf3;
          --dim:#8b949e; --accent:#58a6ff; }
  body { background: var(--bg); color: var(--fg);
         font: 14px/1.55 var(--font-sans)"Segoe UI", Helvetica, Arial, sans-serif;
         margin:0; padding: 28px 18px 60px; }
  body > :not(.topbar):not(.skiplink) { max-width: 860px; margin-left: auto; margin-right: auto; }
  a { color: var(--accent); text-decoration: none; } a:hover { text-decoration: underline; } body > nav a { color: var(--dim); font-size: 13px; }
  h1 { font-size: 26px; margin: 14px 0 4px; } h1 span { color: var(--accent); }
  .sub { color: var(--dim); margin-bottom: 18px; }
  table { border-collapse: collapse; width: 100%; margin-top: 8px; }
  th { text-align: left; color: var(--dim); font-size: 11px; text-transform: uppercase;
       letter-spacing: .04em; padding: 6px 10px; border-bottom: 1px solid var(--border); }
  td { padding: 6px 10px; border-bottom: 1px solid var(--border); font-size: 13px; vertical-align: top; }
  .who { font-family: ui-monospace, monospace; color: var(--fg); font-weight: 600; }
  .num { text-align: right; white-space: nowrap; font-family: ui-monospace, monospace; }
  .last { color: var(--dim); font-size: 12px; }
  .last a { color: var(--dim); }
  .srcs { color: var(--dim); font-size: 11px; }
  footer { margin-top: 40px; padding-top: 16px; border-top: 1px solid var(--border); color: var(--dim); font-size: 12px; }
  #err { color: var(--dim); }

  /* a11y floor: focus ring + reduced motion (hallmark-style audit 2026-11-16) */
  :focus-visible { outline: 2px solid var(--accent, #58a6ff); outline-offset: 2px; }
</style>
