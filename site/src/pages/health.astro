---
import Base from "../layouts/Base.astro";
const title = "status \u2014 trendscope";
const description = "Source health for the trendscope pipeline: per-source uptime, latency and item counts across collection runs.";
const path = '/health.html';
---
<Base title={title} description={description} path={path} nav="none">

<nav><a href="index.html">← trendscope</a> · <a href="state-of-rss.html">state of RSS</a> · <a href="streaks.html">streaks</a> · <a href="compare.html">compare</a> · <a href="digest.html">digests</a></nav>
  <h1>status</h1>
  <p class="sub">Public pipeline health — every collection run logs <code>date,source,ok,items,ms</code> to
    <code>data/health-log.csv</code>. This page renders it.</p>
  <div id="out"><p id="err">loading…</p></div>

<script is:inline src="/js/pages/health.mjs" type="module"></script>

<footer>Open data, <a href="https://creativecommons.org/publicdomain/zero/1.0/">CC0</a> ·     <a href="https://github.com/zalize-com/trendscope">github.com/zalize-com/trendscope</a></footer>

</Base>

<style is:global>
@media (prefers-color-scheme:dark){:root{ --bg:#0d1117; --panel:#161b22; --border:#30363d; --fg:#e6edf3;
          --dim:#8b949e; --accent:#58a6ff; --green:#3fb950; }}
  body { background: var(--bg); color: var(--fg);
         font: 14px/1.55 -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
         max-width: 860px; margin: 0 auto; padding: 28px 18px 60px; }
  a { color: var(--accent); text-decoration: none; } a:hover { text-decoration: underline; }
  nav a { color: var(--dim); font-size: 13px; }
  h1 { font-size: 26px; margin: 14px 0 4px; } h1 span { color: var(--green); }
  .sub { color: var(--dim); margin-bottom: 18px; }
  table { border-collapse: collapse; width: 100%; margin-top: 8px; }
  th { text-align: left; color: var(--dim); font-size: 11px; text-transform: uppercase;
       letter-spacing: .04em; padding: 6px 10px; border-bottom: 1px solid var(--border); }
  td { padding: 6px 10px; border-bottom: 1px solid var(--border); font-size: 13px; vertical-align: top; }
  .src { font-family: ui-monospace, monospace; font-weight: 600; }
  .num { text-align: right; font-family: ui-monospace, monospace; white-space: nowrap; }
  .dot { display:inline-block; width:11px; height:11px; border-radius:2px; margin-right:3px; }
  .ok { background: var(--green); } .bad { background: var(--red); } .none { background: var(--border); }
  .legend { color: var(--dim); font-size: 12px; margin: 6px 0 14px; }
  h2 { font-size: 15px; margin: 22px 0 4px; color: var(--dim); text-transform: uppercase; letter-spacing:.05em; }
  footer { margin-top: 40px; padding-top: 16px; border-top: 1px solid var(--border); color: var(--dim); font-size: 12px; }
  #err { color: var(--dim); }
  .banner { border:1px solid var(--border); border-radius:10px; padding:12px 16px; margin:10px 0 18px; }

  /* a11y floor: focus ring + reduced motion (hallmark-style audit 2026-11-16) */
  :focus-visible { outline: 2px solid var(--accent, #58a6ff); outline-offset: 2px; }
</style>
