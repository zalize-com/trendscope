---
import Base from "../layouts/Base.astro";
const title = "velocity \u2014 trendscope";
const description = "Items that keep climbing \u2014 score gained per day for URLs seen on multiple snapshots.";
const path = '/velocity.html';
---
<Base title={title} description={description} path={path} nav="none">

<nav><a href="index.html">← trendscope</a> · <a href="risers.html">risers</a> · <a href="streaks.html">streaks</a> · <a href="weekday.html">weekday</a></nav>
  <h1 id="h1">velocity</h1>
  <div class="sub" id="sub">loading…</div>
  <h2>score gained per day — multi-day items</h2>
  <div id="grid"><p id="err">loading…</p></div>

<script is:inline src="/js/pages/velocity.js"></script>

<footer>
    Same URL seen on ≥2 snapshot days: (last score − first score) ÷ days between. Computed in your browser from <a href="data/history.csv">history.csv</a>. ·     <a href="https://github.com/zalize-com/trendscope">trendscope</a>
  </footer>

</Base>

<style is:global>
@media (prefers-color-scheme: dark) {
  :root:not([data-theme]) { --bg:#0d1117; --panel:#161b22; --border:#30363d; --fg:#e6edf3;
          --dim:#8b949e; --accent:#58a6ff; --green:#3fb950; }
}
html[data-theme="dark"] { --bg:#0d1117; --panel:#161b22; --border:#30363d; --fg:#e6edf3;
          --dim:#8b949e; --accent:#58a6ff; --green:#3fb950; }
  body { background: var(--bg); color: var(--fg);
         font: 14px/1.55 -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
         margin:0; padding: 28px 18px 60px; }
  body > :not(.topbar):not(.skiplink) { max-width: 860px; margin-left: auto; margin-right: auto; }
  a { color: var(--accent); text-decoration: none; } a:hover { text-decoration: underline; } body > nav a { color: var(--dim); font-size: 13px; }
  h1 { font-size: 26px; margin: 14px 0 4px; } h1 span { color: var(--accent); }
  .sub { color: var(--dim); margin-bottom: 18px; }
  h2 { font-size: 15px; color: var(--dim); font-weight: 600; margin: 26px 0 6px;
       text-transform: uppercase; letter-spacing: .04em; }
  table { border-collapse: collapse; width: 100%; font-size: 13px; }
  td, th { border-bottom: 1px solid var(--border); padding: 5px 6px; text-align: left; }
  th { color: var(--dim); font-weight: 600; font-size: 11px; text-transform: uppercase; }
  td.n { text-align: right; white-space: nowrap; color: var(--green); font-variant-numeric: tabular-nums; }
  td.d { color: var(--dim); font-size: 12px; white-space: nowrap; }
  .src { color: var(--dim); font-size: 10px; border: 1px solid var(--border);
         border-radius: 4px; padding: 0 4px; white-space: nowrap; }
  footer { margin-top: 40px; padding-top: 16px; border-top: 1px solid var(--border); color: var(--dim); font-size: 12px; }
  #err { color: var(--dim); }

  /* a11y floor: focus ring + reduced motion (hallmark-style audit 2026-11-16) */
  :focus-visible { outline: 2px solid var(--accent, #58a6ff); outline-offset: 2px; }
</style>
