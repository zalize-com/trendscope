---
import Base from "../layouts/Base.astro";
const title = "daily-updating open datasets \u2014 trendscope";
const description = "A curated list of open datasets that update themselves daily \u2014 developer attention, news archives, package stats, and more.";
const path = '/datasets.html';
// ItemList markup turns this catalog into a Google Dataset Search surface —
// each listed dataset gets its own Dataset node.
const jsonld = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "daily-updating open datasets",
  "description": description,
  "itemListElement": [
    {"@type": "Dataset", "position": 1, "name": "trendscope — developer attention dataset",
     "description": "Daily cross-source snapshot of what developers are reading & building across 9,200+ tracked sources. JSON+CSV, versioned history, machine-readable APIs.",
     "url": "https://github.com/zalize-com/trendscope",
     "license": "https://creativecommons.org/publicdomain/zero/1.0/",
     "isAccessibleForFree": true,
     "temporalCoverage": "2026-11-07/..",
     "distribution": [
       {"@type": "DataDownload", "encodingFormat": "application/json", "contentUrl": "data/latest.json"},
       {"@type": "DataDownload", "encodingFormat": "text/csv", "contentUrl": "data/history.csv"}]},
    {"@type": "Dataset", "position": 2, "name": "Hacker News API",
     "description": "Every HN item & change stream via Firebase — raw firehose.",
     "url": "https://github.com/HackerNews/API", "isAccessibleForFree": true},
    {"@type": "Dataset", "position": 3, "name": "GH Archive",
     "description": "Every public GitHub event, hourly BigQuery/downloadable archives.",
     "url": "https://www.gharchive.org", "isAccessibleForFree": true},
    {"@type": "Dataset", "position": 4, "name": "PyPI download counts (pypistats)",
     "description": "Daily/monthly download counts per PyPI package, JSON API.",
     "url": "https://pypistats.org", "isAccessibleForFree": true},
    {"@type": "Dataset", "position": 5, "name": "npm downloads API",
     "description": "Download counts per package/range.", "url": "https://api.npmjs.org",
     "isAccessibleForFree": true},
    {"@type": "Dataset", "position": 6, "name": "libraries.io open data",
     "description": "Cross-ecosystem package metadata dumps.",
     "url": "https://libraries.io/data", "license": "CC-BY-SA", "isAccessibleForFree": true},
    {"@type": "Dataset", "position": 7, "name": "Our World in Data",
     "description": "Global indicators, many auto-updated series, charts+CSV+API.",
     "url": "https://ourworldindata.org", "license": "CC-BY", "isAccessibleForFree": true},
    {"@type": "Dataset", "position": 8, "name": "Wikipedia pageviews",
     "description": "Hourly pageview dumps per article, whole-history.",
     "url": "https://dumps.wikimedia.org/other/pageviews/", "isAccessibleForFree": true},
  ],
};
---
<Base title={title} description={description} path={path} nav="none" jsonld={jsonld}>

<nav><a href="index.html">← trendscope</a> · <a href="about.html">about</a> · <a href="docs/api.md">api docs</a></nav>
  <h1>daily-updating <span>open datasets</span></h1>
  <div class="sub">Open data that refreshes itself every day — no signup, no key.
    Most "live" dashboards hoard their history; these publish it. Curated by the trendscope project.</div>

  <div style="border:1px solid var(--border);border-left:3px solid var(--accent);border-radius:0 8px 8px 0;padding:12px 16px;margin:0 0 8px;background:rgba(88,166,255,.05)">
    <b>Bring your own reader:</b> our full source list as <a href="trendscope.opml" style="font-weight:600">trendscope.opml</a> —
    9,300+ feeds in one file, importable into Feedly, NetNewsWire, FreshRSS or any OPML reader — or <a href="feeds.html">browse the feed directory</a>.
    Regenerated daily by CI, same CC0 license as the data.
  </div>

  <h2>developer attention & news</h2>
  <table>
    <tr><th>dataset</th><th>what's inside</th><th>cadence</th><th class="lic">license</th></tr>
    <tr class="us"><td><a href="https://github.com/zalize-com/trendscope">trendscope</a> ◂ us</td>
      <td>Daily cross-source snapshot of what developers are reading & building: HN, GitHub Trending, Lobsters, Dev.to, Product Hunt, Techmeme, Slashdot, npm/PyPI/crates downloads. JSON+CSV, versioned history, machine-readable APIs. Source list as <a href="trendscope.opml">OPML</a> — import all 9,300+ feeds into your own reader.</td>
      <td>daily</td><td class="lic">CC0</td></tr>
    <tr><td><a href="https://github.com/HackerNews/API">HN API (official)</a></td>
      <td>Every HN item & change stream via Firebase — raw firehose, no ranking snapshots.</td>
      <td>realtime</td><td class="lic">open</td></tr>
    <tr><td><a href="https://www.gharchive.org">GH Archive</a></td>
      <td>Every public GitHub event, hourly BigQuery/downloadable archives.</td>
      <td>hourly</td><td class="lic">CC-BY</td></tr>
    <tr><td><a href="https://lobste.rs/hottest.json">Lobste.rs JSON</a></td>
      <td>Front-page JSON endpoints — live only, no history.</td>
      <td>realtime</td><td class="lic">open</td></tr>
    <tr class="us"><td><a href="https://github.com/zalize-com/feedpaper">feedpaper</a> ◂ sister project</td>
      <td>Not a dataset — a forkable template: your own curated feed digest, generated daily into your repo as JSON. Same "data stays in your repo" pattern.</td>
      <td>daily</td><td class="lic">MIT</td></tr>
  </table>

  <h2>package ecosystems</h2>
  <table>
    <tr><th>dataset</th><th>what's inside</th><th>cadence</th><th class="lic">license</th></tr>
    <tr><td><a href="https://pypistats.org">pypistats</a></td><td>PyPI download counts, daily/monthly per package, JSON API.</td><td>daily</td><td class="lic">open</td></tr>
    <tr><td><a href="https://api.npmjs.org">npm downloads API</a></td><td>Download counts per package/range.</td><td>daily</td><td class="lic">open</td></tr>
    <tr><td><a href="https://libraries.io">libraries.io open data</a></td><td>Cross-ecosystem package metadata dumps (periodic).</td><td>periodic</td><td class="lic">CC-BY-SA</td></tr>
  </table>

  <h2>everything else</h2>
  <table>
    <tr><th>dataset</th><th>what's inside</th><th>cadence</th><th class="lic">license</th></tr>
    <tr><td><a href="https://ourworldindata.org">Our World in Data</a></td><td>Global indicators, many auto-updated series, charts+CSV+API.</td><td>daily+</td><td class="lic">CC-BY</td></tr>
    <tr><td><a href="https://github.com/CSSEGISandData/COVID-19">JHU COVID-19</a></td><td>The canonical git-committed daily dataset — the pattern trendscope follows.</td><td>daily</td><td class="lic">open</td></tr>
    <tr><td><a href="https://www.wikipedia.org">Wikipedia pageviews</a></td><td>Hourly pageview dumps per article, whole-history.</td><td>hourly</td><td class="lic">open</td></tr>
  </table>

<footer>
    Know another daily-updating open dataset? <a href="https://github.com/zalize-com/trendscope">Open a PR</a> —
    this list is a curated page of the trendscope repo. · CC0
  </footer>

</Base>

<style is:global>
@media (prefers-color-scheme: dark) {
  :root:not([data-theme]) { --bg:#0d1117; --panel:#161b22; --border:#30363d; --fg:#e6edf3;
          --dim:#8b949e; --accent:#58a6ff; --green:#3fb950; }
}
html[data-theme="dark"] { --bg:#0d1117; --panel:#161b22; --border:#30363d; --fg:#e6edf3;
          --dim:#8b949e; --accent:#58a6ff; --green:#3fb950; }
  body { background: var(--bg); color: var(--fg);
         font: 14px/1.55 -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
         margin:0; padding: 28px 18px 60px; }
  body > :not(.topbar):not(.skiplink) { max-width: 860px; margin-left: auto; margin-right: auto; }
  a { color: var(--accent); text-decoration: none; } a:hover { text-decoration: underline; } body > nav a { color: var(--dim); font-size: 13px; }
  h1 { font-size: 26px; margin: 14px 0 4px; } h1 span { color: var(--accent); }
  .sub { color: var(--dim); margin-bottom: 18px; }
  h2 { font-size: 15px; color: var(--dim); font-weight: 600; margin: 26px 0 6px;
       text-transform: uppercase; letter-spacing: .04em; }
  table { width: 100%; border-collapse: collapse; margin: 8px 0 20px; }
  td, th { padding: 7px 10px; border-bottom: 1px solid var(--border); text-align: left; vertical-align: top; }
  th { color: var(--dim); font-size: 12px; font-weight: 600; }
  td:first-child { white-space: nowrap; font-weight: 600; }
  .lic { color: var(--dim); font-size: 12px; white-space: nowrap; }
  .us { background: rgba(88,166,255,.08); }
  footer { margin-top: 40px; padding-top: 16px; border-top: 1px solid var(--border); color: var(--dim); font-size: 12px; }

  /* a11y floor: focus ring + reduced motion (hallmark-style audit 2026-11-16) */
  :focus-visible { outline: 2px solid var(--accent, #58a6ff); outline-offset: 2px; }
</style>
