---
import Base from "../layouts/Base.astro";
const title = "api clients \u2014 trendscope";
const description = "Copy-paste clients for the trendscope API in curl, Python and JavaScript \u2014 plus the MCP server for agents.";
const path = '/clients.html';
---
<Base title={title} description={description} path={path} nav="none">

<nav><a href="index.html">&larr; board</a><a href="api.html">api</a><a href="swagger.html">swagger</a><a href="docs/api.md">api.md</a></nav>
<h1>api clients</h1>
<p class="muted">Copy-paste starters for the trendscope API — no keys, no signup, plain JSON. Base: <code>https://trendscope.zalize.com</code>.</p>

<h2>curl</h2>
<pre>BASE=https://trendscope.zalize.com
curl -s $BASE/data/latest.json | python3 -m json.tool | head -40
curl -s $BASE/docs/api/new.json      # today's fresh items
curl -s $BASE/docs/api/meteors.json  # biggest 1-day climbers
curl -s $BASE/docs/api/streaks.json  # board veterans
curl -s $BASE/docs/api/meta.json     # machine-readable catalog</pre>

<h2>python (stdlib only)</h2>
<pre>import json, urllib.request
BASE = "https://trendscope.zalize.com"
latest = json.load(urllib.request.urlopen(BASE + "/data/latest.json"))
items = [i for v in latest["items"].values() for i in v] if isinstance(latest.get("items"), dict) else latest["items"]
for it in items[:10]:
    print(it["rank"], it["title"], it["url"])</pre>

<h2>javascript / browser</h2>
<pre>const BASE = "https://trendscope.zalize.com";
const latest = await (await fetch(BASE + "/data/latest.json")).json();
const items = Object.values(latest.items).flat(); // dict-of-lists or list
console.table(items.slice(0, 10));</pre>

<h2>web component</h2>
<pre>&lt;script src="https://trendscope.zalize.com/docs/api/widget.js"&gt;&lt;/script&gt;
&lt;trend-scope mode="board" n="10"&gt;&lt;/trend-scope&gt;</pre>

<h2>MCP server (agents)</h2>
<pre># zero-dep stdio MCP server wrapping the API
git clone https://github.com/zalize-com/trendscope
python3 trendscope/scripts/mcp_server.py
# tools: ts_latest ts_new ts_risers ts_search ts_streaks ts_topics ts_sources
# override base: TRENDSCOPE_BASE=http://localhost:8000</pre>

<h2>iframe embeds</h2>
<pre>&lt;iframe src="https://trendscope.zalize.com/embed.html?mode=board&n=5"
        style="width:420px;height:300px;border:0"&gt;&lt;/iframe&gt;
# 26 modes — gallery at embeds.html</pre>

<footer>trendscope api clients · CC0 · <a href="https://github.com/zalize-com/trendscope">source</a></footer>

</Base>

<style is:global>
body{font: 15px/1.6 var(--font-sans);margin:0;padding:16px;color:var(--fg)}
  body > :not(.topbar):not(.skiplink) { max-width: 840px; margin-left: auto; margin-right: auto; }
h1{font-size:22px;margin:0 0 4px}
h2{font-size:16px;margin:22px 0 6px}
a{color:var(--accent);text-decoration:none}
a:hover{text-decoration:underline} body > nav{font-size:13px;margin:8px 0 16px;color:var(--muted)} body > nav a{margin-right:10px}
pre{background:var(--card);border:1px solid var(--border);border-radius:6px;padding:10px;font:12px/1.5 ui-monospace,monospace;overflow-x:auto}
.muted{color:var(--muted);font-size:13px}
footer{margin-top:28px;font-size:12px;color:var(--muted);border-top:1px solid var(--border);padding-top:10px}

  /* a11y floor: focus ring + reduced motion (hallmark-style audit 2026-11-16) */
  :focus-visible { outline: 2px solid var(--accent, #58a6ff); outline-offset: 2px; }
</style>
