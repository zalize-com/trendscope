---
import Base from "../layouts/Base.astro";
const title = "Self-hosted, daily — trendscope";
const description = "Every self-hosting, homelab and own-your-data story across 9,200+ tracked sources, refreshed daily. The self-hosting wave, measured. Open data (CC0).";
const path = "/selfhosted.html";
const jsonld = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": title,
  "description": description,
  "isPartOf": { "@type": "WebSite", "name": "trendscope" },
};
---
<Base title={title} description={description} path={path} nav="none" jsonld={jsonld}>

<nav><a href="index.html">← trendscope</a> · <a href="daily/index.html">daily lanes</a> · <a href="feeds.html">feed directory</a> · <a href="state-of-rss.html">state of rss</a></nav>
  <h1>Self-hosted, <span>daily</span></h1>
  <p class="sub">Self-hosting is the loudest recurring theme in the dev-attention data — maps, analytics,
    tunnels, PDS, runners, calendars, replacements for hosted everything. This page measures the wave:
    every self-hosting / homelab / own-your-data item across all 9,200+ tracked sources, refreshed daily.
    Part of the <a href="https://trendscope.zalize.com" style="font-weight:600">trendscope</a> open dataset (CC0).</p>
  <div id="daily"><p id="err">loading…</p></div>
  <p class="sub" style="margin-top:18px">Want your own daily digest of feeds you choose?
    <a href="https://feedpaper.zalize.com">feedpaper</a> — fork a repo, edit feeds.yaml, done. Your data stays in YOUR repo.</p>

<script is:inline src="/js/pages/selfhosted.mjs" type="module"></script>

<footer>Open data, <a href="https://creativecommons.org/publicdomain/zero/1.0/">CC0</a> ·
    <a href="https://github.com/zalize-com/trendscope">github.com/zalize-com/trendscope</a></footer>

</Base>

<style is:global>
  body { padding: 28px 18px 60px; margin: 0; }
  body > :not(.topbar):not(.skiplink) { max-width: 960px; margin-left: auto; margin-right: auto; }
  #daily .row { display:grid; grid-template-columns:34px 1fr auto; gap:8px; padding:7px 0;
    border-bottom:1px solid var(--border); align-items:baseline; }
  #daily .rank { color:var(--dim); font-variant-numeric:tabular-nums; font-size:12px; }
  #daily .meta { color:var(--dim); font-size:11px; white-space:nowrap; }
  #daily .score { color:var(--orange); font-weight:600; font-size:12px; }
  #daily .stamp { color:var(--dim); font-size:12px; margin-bottom:10px; }
  .sub { color: var(--dim); }
</style>
