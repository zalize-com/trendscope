---
import Base from "../layouts/Base.astro";
const title = "ideas \u2014 trendscope";
const description = "The demand lane: what developers are asking for, aggregated from Ask HN items across the trendscope dataset.";
const path = '/ideas.html';
---
<Base title={title} description={description} path={path} nav="none">

<nav><a href="index.html">← trendscope</a> · <a href="compare.html">compare</a> · <a href="streaks.html">streaks</a> · <a href="digest.html">digests</a></nav>
  <h1>idea<span>s</span></h1>
  <p class="sub">The demand lane. Ask HN is a self-reporting wishlist: people publicly describe what they'd
    pay for, switch to, or build. Aggregated from <code>ask_hn</code> items across the dataset history —
    repeated themes = repeated demand.</p>
  <div class="stats" id="stats"></div>
  <p class="sub" id="hiring" style="margin-bottom:18px"></p>
  <div id="out"><p id="err">loading…</p></div>
  <p class="note">Method: keyword clustering over question titles (unigrams/bigrams, stopword-filtered).
    A theme needs ≥2 distinct threads across the dataset history to appear. Points are HN score, a rough
    proxy for how many devs share the itch.</p>

<script is:inline src="/js/pages/ideas.mjs" type="module"></script>

</Base>

<style is:global>
@media (prefers-color-scheme:dark){:root{ --bg:#0d1117; --panel:#161b22; --border:#30363d; --fg:#e6edf3;
          --dim:#8b949e; --accent:#58a6ff; --green:#3fb950; --orange:#d29922; }}
  body { background: var(--bg); color: var(--fg);
         font: 14px/1.55 -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
         max-width: 860px; margin: 0 auto; padding: 28px 18px 60px; }
  a { color: var(--accent); text-decoration: none; } a:hover { text-decoration: underline; }
  nav a { color: var(--dim); font-size: 13px; }
  h1 { font-size: 26px; margin: 14px 0 4px; } h1 span { color: var(--accent); }
  .sub { color: var(--dim); margin-bottom: 18px; max-width: 640px; }
  .stats { display: flex; gap: 18px; flex-wrap: wrap; margin: 10px 0 6px; }
  .stat b { font-size: 22px; } .stat small { color: var(--dim); display: block; font-size: 11px; }
  h2 { font-size: 15px; color: var(--dim); font-weight: 600; margin: 26px 0 6px;
       text-transform: uppercase; letter-spacing: .04em; }
  ol, ul { list-style: none; }
  li { display: flex; gap: 10px; padding: 5px 0; border-bottom: 1px solid var(--border); align-items: baseline; }
  .it a { color: var(--fg); } .it a:hover { color: var(--accent); }
  .src { color: var(--dim); font-size: 11px; border: 1px solid var(--border);
         border-radius: 4px; padding: 0 5px; margin-left: 6px; }
  .sc { margin-left: auto; white-space: nowrap; font-size: 12px; color: var(--dim); }
  .pts { color: var(--orange); font-weight: 600; }
  .days { color: var(--green); }
  .theme { background: var(--panel); border: 1px solid var(--border); border-radius: 8px;
           padding: 10px 14px; margin-bottom: 10px; }
  .theme h3 { font-size: 14px; color: var(--accent); margin-bottom: 6px; }
  .theme h3 b { color: var(--orange); }
  .theme ul li { border-bottom: none; padding: 2px 0; }
  .theme .it a { color: var(--dim); } .theme .it a:hover { color: var(--accent); }
  .theme .it a { font-size: 13px; }
  footer { margin-top: 40px; padding-top: 16px; border-top: 1px solid var(--border); color: var(--dim); font-size: 12px; }
  #err { color: var(--dim); }
  .note { color: var(--dim); font-size: 12px; margin-top: 8px; }
  .strip { display:flex; gap:5px; align-items:flex-end; margin:4px 0 0; }
  .db { display:inline-flex; flex-direction:column; align-items:center; gap:2px; }
  .db i { display:block; width:14px; background:var(--accent,#58a6ff); opacity:.65; border-radius:2px; }
  .db s { text-decoration:none; font-size:9px; color:var(--dim); }

  /* a11y floor: focus ring + reduced motion (hallmark-style audit 2026-11-16) */
  :focus-visible { outline: 2px solid var(--accent, #58a6ff); outline-offset: 2px; }
</style>
