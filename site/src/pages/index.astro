---
import Layout from '../layouts/Base.astro';
import RailCard from '../components/RailCard.astro';
import Section from '../components/Section.astro';
import Card from '../components/Card.astro';

const jsonld = {
  "@context": "https://schema.org",
  "@type": "Dataset",
  "name": "trendscope — developer attention dataset",
  "description": "Daily cross-source snapshot of developer attention across 9213 tracked sources: Hacker News, GitHub Trending, Lobste.rs, Dev.to, Product Hunt, Techmeme, major engineering blogs, Chinese tech media, and thousands more.",
  "keywords": ["hacker news","github trending","developer trends","open dataset","daily snapshot"],
  "creator": {"@type": "Organization", "name": "zalize-com", "url": "https://github.com/zalize-com/trendscope"},
  "license": "https://creativecommons.org/publicdomain/zero/1.0/",
  "isAccessibleForFree": true,
  "temporalCoverage": "2026-11-07/..",
  "distribution": [
    {"@type": "DataDownload", "encodingFormat": "application/json", "contentUrl": "data/latest.json"},
    {"@type": "DataDownload", "encodingFormat": "text/csv", "contentUrl": "data/history.csv"}
  ]
};
---
<Layout
  title="trendscope — daily open dataset of what developers are reading & building"
  description="trendscope is a daily open dataset of developer attention: Hacker News, GitHub trending, Product Hunt, Lobste.rs, Dev.to, Ars Technica, The Verge, arXiv, Slashdot, npm, PyPI, crates.io and more — snapshotted every day, free to download (CC0)."
  path="/index.html"
  nav="board"
  ogTitle="trendscope — the developer attention dataset"
  ogDescription="Daily cross-source snapshot of what developers are reading, building and downloading. Open data, CC0."
  keywords="hacker news daily, github trending, developer trends dataset, open dataset, npm downloads, pypi downloads"
  jsonld={jsonld}
>
  <Fragment slot="head">
    <script is:inline src="https://unpkg.com/minisearch@7.1.2/dist/umd/index.js"></script>
  </Fragment>

<div class="wrap">

  <header class="pagehead">
    <h1 class="pagetitle"><span class="radar" aria-hidden="true"></span><span><span id="board-title">Today's</span> cross-source board</span></h1>
    <p class="pagesub" id="board-sub">The developer attention dataset — updated twice daily.</p>
    <p id="err">Could not load <code>data/latest.json</code> — the first snapshot may not have run yet.</p>
  </header>

  <div class="dash">
    <main class="dash-main">
      <div class="tabs" id="tabs"></div>
      <input id="q" class="d-input d-input-bordered w-full" type="search" placeholder="search 107k items across all sources… ⏎ = HN 19y">
      <div id="cpk-bar" style="display:none;margin:0 0 10px">
        <input id="cpk-input" class="d-input d-input-bordered d-input-sm" placeholder="track an npm package — e.g. hono">
        <a id="cpk-add" class="d-btn d-btn-sm" style="margin-top:0;cursor:pointer">+ track</a>
        <span class="muted" style="font-size:12px;margin-left:8px">saved in your browser · npm / crates:name / gh:owner/repo</span>
      </div>
      <div class="board" id="board"></div>
      <p class="board-actions"><a id="png-btn" style="cursor:pointer">⤓ export board as PNG</a> · <a id="csv-btn" style="cursor:pointer">⤓ download board as CSV</a> · <a id="md-btn" style="cursor:pointer">⧉ copy board as markdown</a> · <a id="json-btn" style="cursor:pointer">⤓ download board as JSON</a> · <a id="cmp-link" style="cursor:pointer;display:none">↔ vs previous day</a> <span class="muted">· share today's top stories anywhere</span></p>
    </main>

    <aside class="rail">
      <RailCard title="Snapshot">
        <div class="stamp" id="stamp">loading…</div>
        <div class="daypick-row">
          <select id="daypick" class="d-select d-select-bordered d-select-sm w-full" style="display:none"></select>
          <span class="muted" id="daypick-hint"></span>
        </div>
      </RailCard>
      <RailCard title="Signals">
        <div class="status-item" id="src-health"></div>
        <div class="status-item" id="brief-link"></div>
        <div class="status-item" id="hiring-pulse"></div>
        <div class="status-item" id="month-history"></div>
      </RailCard>
      <RailCard title="By topic">
        <div class="topics" id="topics"></div>
      </RailCard>
    </aside>
  </div>

  <Section title="Topic trend" sub="items per day across sources">
    <div class="cards" id="trend-cards">
      <div class="card"><p class="muted">Collecting history…</p></div>
    </div>
  </Section>

  <Section title="Rising this week" sub="velocity vs. previous snapshots">
    <div class="board" id="rising">
      <div class="row"><span></span><span class="muted" id="rising-empty">Loading…</span><span></span></div>
    </div>
  </Section>

  <Section title="Dataset" sub="CC0 — take it, use it, cite us">
    <div class="cards">
      <Card title="Latest snapshot">
        <p>All items from the most recent run, normalized schema.</p>
        <a class="d-btn d-btn-sm" href="data/latest.json">latest.json</a>
        <a class="d-btn d-btn-sm d-btn-outline" href="data/latest.csv">latest.csv</a>
      </Card>
      <Card title="Full history">
        <p>Append-only cumulative rows for velocity analysis. <span id="hist-days"></span></p>
        <a class="d-btn d-btn-sm" href="data/history.csv">history.csv</a>
        <a class="d-btn d-btn-sm d-btn-outline" href="data/index.json">index.json</a>
      </Card>
      <Card title="Daily archives">
        <p>Per-day JSON + CSV snapshots under <code>data/daily/</code>.</p>
        <div id="daily-links"></div>
      </Card>
      <Card title="Schema">
        <p><code>source, rank, title, url, score, metric, comments, author, tags, captured_at</code></p>
        <a class="d-btn d-btn-sm d-btn-outline" href="docs/data-dictionary.md">data-dictionary.md</a>
        <a class="d-btn d-btn-sm d-btn-outline" href="docs/api.md">api docs →</a>
      </Card>
      <Card title="Digest &amp; feed">
        <p>Weekly narrative notes + machine digest, and an RSS feed of every snapshot.</p>
        <a class="d-btn d-btn-sm" href="feed.xml">feed.xml</a>
        <a class="d-btn d-btn-sm d-btn-outline" href="embed.html">embed widget →</a> <a class="d-btn d-btn-sm d-btn-outline" href="embeds.html">gallery</a>
        <a class="d-btn d-btn-sm d-btn-outline" href="digest.html">weekly digests →</a>
      </Card>
    </div>
  </Section>

  <footer>
    <p><b>Method.</b> A GitHub Action runs <code>scripts/collect.py</code> twice a day (06:05 + 18:05 UTC), aggregating public keyless endpoints:
       Hacker News (Algolia), Show/Ask HN, GitHub trending, Lobste.rs, Dev.to, Product Hunt, Techmeme, Slashdot, Ars Technica, arXiv, npm downloads, PyPI Stats, crates.io.
       Scores are source-native (points / stars / reactions / downloads) — compare within a source, not across.
       Related: <a href="https://github.com/zalize-com/feedpaper">feedpaper</a> — fork it for your own daily digest.</p>
    <p style="margin-top:8px">Open data, <a href="https://creativecommons.org/publicdomain/zero/1.0/">CC0</a>.
       Built in the open — <a href="https://github.com/zalize-com/trendscope">source on GitHub</a> ·        <a href="about.html">about & methodology</a> ·        <a href="compare.html">compare snapshots</a> ·        <a href="streaks.html">streaks</a> · <a href="oldest.html">veterans</a> · <a href="gone.html">gone</a> · <a href="glossary.html">glossary</a> ·        <a href="risers.html">risers</a> · <a href="velocity.html">velocity</a> · <a href="crossovers.html">crossovers</a> ·        <a href="movers.html">movers</a> ·        <a href="new.html">new</a> · <a href="radar.html">radar</a> · <a href="watch.html">watch</a> · <a href="meteors.html">meteors</a> · <a href="heatmap.html">heat</a> · <a href="cite.html">cite</a> · <a href="stack.html">stack</a> · <a href="support.html">support</a> · <a href="swagger.html">api explorer</a> ·        <a href="sources.html">sources</a> ·        <a href="domains.html">domains</a> ·        <a href="authors.html">authors</a> ·        <a href="discuss.html">discussed</a> ·        <a href="ideas.html">ideas</a> ·        <a href="item.html">item</a> · <a href="week.html">this week</a> · <a href="calendar.html">calendar</a> · <a href="rhythm.html">rhythm</a> · <a href="weekday.html">weekday</a> · <a href="canon.html">canon</a> · <a href="showhn.html">show&nbsp;hn</a> · <a href="rituals.html">rituals</a> · <a href="year.html">a&nbsp;year</a> · <a href="digest.html">digests</a> ·        <a href="api.html">api</a> ·        <a href="changelog.html">changelog</a> ·        <a href="faq.html">faq</a> ·        <a href="health.html">status</a> · <a href="stats.html">stats</a> · <a href="hiring.html">hiring</a>.</p>
  </footer>

</div>

<script is:inline src="https://unpkg.com/minisearch@7.1.2/dist/umd/index.js"></script>
<script src="/js/index-body.js" is:inline></script>

</Layout>
