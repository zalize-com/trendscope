---
import Layout from '../layouts/Layout.astro';

const jsonld = {
  "@context": "https://schema.org",
  "@type": "Dataset",
  "name": "trendscope — developer attention dataset",
  "description": "Daily cross-source snapshot of developer attention across 9213 tracked sources: Hacker News, GitHub Trending, Lobste.rs, Dev.to, Product Hunt, Techmeme, major engineering blogs, Chinese tech media, and thousands more.",
  "keywords": ["hacker news","github trending","developer trends","open dataset","daily snapshot"],
  "creator": {"@type": "Organization", "name": "zalize-com", "url": "https://github.com/zalize-com/trendscope"},
  "license": "https://creativecommons.org/publicdomain/zero/1.0/",
  "isAccessibleForFree": true,
  "temporalCoverage": "2026-11-07/..",
  "distribution": [
    {"@type": "DataDownload", "encodingFormat": "application/json", "contentUrl": "data/latest.json"},
    {"@type": "DataDownload", "encodingFormat": "text/csv", "contentUrl": "data/history.csv"}
  ]
};
---
<Layout
  title="trendscope — daily open dataset of what developers are reading & building"
  description="trendscope is a daily open dataset of developer attention: Hacker News, GitHub trending, Product Hunt, Lobste.rs, Dev.to, Ars Technica, The Verge, arXiv, Slashdot, npm, PyPI, crates.io and more — snapshotted every day, free to download (CC0)."
  path="/index.html"
  nav="board"
  ogTitle="trendscope — the developer attention dataset"
  ogDescription="Daily cross-source snapshot of what developers are reading, building and downloading. Open data, CC0."
  keywords="hacker news daily, github trending, developer trends dataset, open dataset, npm downloads, pypi downloads"
  jsonld={jsonld}
>
  <Fragment slot="head">
    <script src="https://unpkg.com/minisearch@7.1.2/dist/umd/index.js"></script>
  </Fragment>

<div class="wrap">

  <header class="hero" style="padding-top:0">
    <p class="tagline" style="margin-top:4px">The developer attention dataset — updated twice daily.</p>
    <div class="stamp" id="stamp">loading…</div>
    <div id="src-health" class="muted" style="font-size:12px;margin-top:4px"></div>
    <div id="brief-link" class="muted" style="font-size:12px;margin-top:2px"></div>
    <div id="hiring-pulse" class="muted" style="font-size:12px;margin-top:4px"></div>
    <div id="month-history" class="muted" style="font-size:12px;margin-top:4px"></div>
    <div class="topics" id="topics"></div>
    <div style="margin-top:10px">
      <select id="daypick" style="display:none;padding:6px 10px;border-radius:8px;border:1px solid var(--border);background:var(--panel);color:var(--fg);font-size:13px"></select>
      <span class="muted" id="daypick-hint" style="font-size:12px"></span>
    </div>
    <p id="err">Could not load <code>data/latest.json</code> — the first snapshot may not have run yet.</p>
  </header>

  <section>
    <h2><span id="board-title">Today's</span> cross-source board <span class="sub" id="board-sub"></span></h2>
    <div class="tabs" id="tabs"></div>
    <input id="q" type="search" placeholder="search 29k items across all sources… ⏎ = HN 19y" style="width:100%;max-width:340px;margin:0 0 12px;padding:7px 12px;border-radius:8px;border:1px solid var(--border);background:var(--panel);color:var(--fg);font:inherit;font-size:13px">
    <div id="cpk-bar" style="display:none;margin:0 0 10px">
      <input id="cpk-input" placeholder="track an npm package — e.g. hono" style="background:var(--panel);border:1px solid var(--border);border-radius:8px;color:var(--fg);padding:7px 12px;font-size:13px;width:260px">
      <a id="cpk-add" class="btn" style="margin-top:0;padding:5px 12px;cursor:pointer">+ track</a>
      <span class="muted" style="font-size:12px;margin-left:8px">saved in your browser · npm / crates:name / gh:owner/repo</span>
    </div>
    <div class="board" id="board"></div>
    <p style="margin:8px 0 0;font-size:12px"><a id="png-btn" style="cursor:pointer">⤓ export board as PNG</a> · <a id="csv-btn" style="cursor:pointer">⤓ download board as CSV</a> · <a id="md-btn" style="cursor:pointer">⧉ copy board as markdown</a> · <a id="json-btn" style="cursor:pointer">⤓ download board as JSON</a> · <a id="cmp-link" style="cursor:pointer;display:none">↔ vs previous day</a> <span class="muted">· share today's top stories anywhere</span></p>
  </section>

  <section>
    <h2>Topic trend <span class="sub">items per day across sources</span></h2>
    <div class="cards" id="trend-cards">
      <div class="card"><p class="muted">Collecting history…</p></div>
    </div>
  </section>

  <section>
    <h2>Rising this week <span class="sub">velocity vs. previous snapshots</span></h2>
    <div class="board" id="rising">
      <div class="row"><span></span><span class="muted" id="rising-empty">Loading…</span><span></span></div>
    </div>
  </section>

  <section>
    <h2>Dataset <span class="sub">CC0 — take it, use it, cite us</span></h2>
    <div class="cards">
      <div class="card">
        <h3>Latest snapshot</h3>
        <p>All items from the most recent run, normalized schema.</p>
        <a class="btn" href="data/latest.json">latest.json</a>
        <a class="btn ghost" href="data/latest.csv">latest.csv</a>
      </div>
      <div class="card">
        <h3>Full history</h3>
        <p>Append-only cumulative rows for velocity analysis. <span id="hist-days"></span></p>
        <a class="btn" href="data/history.csv">history.csv</a>
        <a class="btn ghost" href="data/index.json">index.json</a>
      </div>
      <div class="card">
        <h3>Daily archives</h3>
        <p>Per-day JSON + CSV snapshots under <code>data/daily/</code>.</p>
        <div id="daily-links"></div>
      </div>
      <div class="card">
        <h3>Schema</h3>
        <p><code>source, rank, title, url, score, metric, comments, author, tags, captured_at</code></p>
        <a class="btn ghost" href="docs/data-dictionary.md">data-dictionary.md</a>
        <a class="btn ghost" href="docs/api.md">api docs →</a>
      </div>
      <div class="card">
        <h3>Digest &amp; feed</h3>
        <p>Weekly narrative notes + machine digest, and an RSS feed of every snapshot.</p>
        <a class="btn" href="feed.xml">feed.xml</a>
        <a class="btn ghost" href="embed.html">embed widget →</a> <a class="btn ghost" href="embeds.html">gallery</a>
        <a class="btn ghost" href="digest.html">weekly digests →</a>
      </div>
    </div>
  </section>

  <footer>
    <p><b>Method.</b> A GitHub Action runs <code>scripts/collect.py</code> twice a day (06:05 + 18:05 UTC), aggregating public keyless endpoints:
       Hacker News (Algolia), Show/Ask HN, GitHub trending, Lobste.rs, Dev.to, Product Hunt, Techmeme, Slashdot, Ars Technica, arXiv, npm downloads, PyPI Stats, crates.io.
       Scores are source-native (points / stars / reactions / downloads) — compare within a source, not across.
       Related: <a href="https://github.com/zalize-com/feedpaper">feedpaper</a> — fork it for your own daily digest.</p>
    <p style="margin-top:8px">Open data, <a href="https://creativecommons.org/publicdomain/zero/1.0/">CC0</a>.
       Built in the open — <a href="https://github.com/zalize-com/trendscope">source on GitHub</a> ·
       <a href="about.html">about & methodology</a> ·
       <a href="compare.html">compare snapshots</a> ·
       <a href="streaks.html">streaks</a> · <a href="oldest.html">veterans</a> · <a href="gone.html">gone</a> · <a href="glossary.html">glossary</a> ·
       <a href="risers.html">risers</a> · <a href="velocity.html">velocity</a> · <a href="crossovers.html">crossovers</a> ·
       <a href="movers.html">movers</a> ·
       <a href="new.html">new</a> · <a href="radar.html">radar</a> · <a href="watch.html">watch</a> · <a href="meteors.html">meteors</a> · <a href="heatmap.html">heat</a> · <a href="cite.html">cite</a> · <a href="stack.html">stack</a> · <a href="support.html">support</a> · <a href="swagger.html">api explorer</a> ·
       <a href="sources.html">sources</a> ·
       <a href="domains.html">domains</a> ·
       <a href="authors.html">authors</a> ·
       <a href="discuss.html">discussed</a> ·
       <a href="ideas.html">ideas</a> ·
       <a href="item.html">item</a> · <a href="week.html">this week</a> · <a href="calendar.html">calendar</a> · <a href="rhythm.html">rhythm</a> · <a href="weekday.html">weekday</a> · <a href="canon.html">canon</a> · <a href="showhn.html">show&nbsp;hn</a> · <a href="rituals.html">rituals</a> · <a href="year.html">a&nbsp;year</a> · <a href="digest.html">digests</a> ·
       <a href="api.html">api</a> ·
       <a href="changelog.html">changelog</a> ·
       <a href="faq.html">faq</a> ·
       <a href="health.html">status</a> · <a href="stats.html">stats</a> · <a href="hiring.html">hiring</a>.</p>
  </footer>

</div>

<script src="https://unpkg.com/minisearch@7.1.2/dist/umd/index.js"></script>
<script src="/js/index-body.js" is:inline></script>

</Layout>
