---
import Base from "../layouts/Base.astro";
const title = "zh source \u2014 trendscope";
const description = "Per-source drill-down into the Chinese tech-source lane \u2014 every item one source published today.";
const path = '/zh-source.html';
---
<Base title={title} description={description} path={path} nav="none">

<nav><a href="zh.html">← 中文源</a> · <a href="index.html">trendscope</a></nav>
<h1 id="t">…</h1>
<p class="sub" id="sub"></p>
<div class="meta" id="meta"></div>
<ol id="list"></ol>
<p id="err"></p>

<script is:inline src="/js/pages/zh-source.js"></script>

<footer>trendscope · <a href="trendscope.opml">OPML</a> · <a href="about.html">about</a></footer>

</Base>

<style is:global>
:root{--fg:#e6edf3;--dim:#8b98a5;--border:#30363d;--panel:#161b22;--accent:#58a6ff;--green:#3fb950}
body{background:#0d1117;color:var(--fg);font:15px/1.6 -apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;margin:0;padding:24px 16px}
  body > :not(.topbar):not(.skiplink) { max-width: 760px; margin-left: auto; margin-right: auto; }
a{color:var(--accent);text-decoration:none}a:hover{text-decoration:underline}
nav{margin-bottom:18px;font-size:13px}
h1{font-size:22px;margin:0}
.sub{color:var(--dim);font-size:13px;margin:4px 0 20px}
.meta{border:1px solid var(--border);border-radius:8px;padding:12px 14px;background:var(--panel);font-size:13px;display:flex;gap:18px;flex-wrap:wrap;margin-bottom:20px}
.meta b{display:block;font-size:18px}
.meta small{color:var(--dim)}
ol{list-style:none;padding:0}
li{padding:8px 0;border-bottom:1px solid var(--border);display:flex;gap:10px;align-items:baseline}
.rk{color:var(--dim);font-size:12px;min-width:22px}
.sc{margin-left:auto;font-size:12px;color:var(--dim);white-space:nowrap}
#err{color:var(--dim)}
footer{margin-top:36px;padding-top:14px;border-top:1px solid var(--border);color:var(--dim);font-size:12px}
</style>
