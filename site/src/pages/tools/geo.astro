---
import Base from "../../layouts/Base.astro";
const title = "trendscope GEO audit \u2014 is AI search citing your site?";
const description = "Free in-browser GEO/AEO checklist: score how visible your site is to ChatGPT, Claude, Perplexity and other AI answer engines. No upload, no signup, no tracking.";
const path = '/tools/geo.html';
---
<Base title={title} description={description} path={path} nav="tools">

<nav><a href="../index.html">← trendscope</a> · <a href="./">tools</a> · <a href="more.html">tools+</a> · <a href="utils.html">utils</a> · <a href="dev.html">dev</a> · <a href="web.html">web</a> · <a href="a11y.html">a11y</a> · <a href="extensions.html">ext?</a></nav>
  <h1>GEO<span> audit</span></h1>
  <p class="sub">"ChatGPT stopped recommending us" is a real 2026 support ticket. This checklist scores how visible your site is to AI answer engines (ChatGPT, Claude, Perplexity, Gemini, Copilot) — everything runs in your browser, nothing is uploaded.</p>
  <div id="cats"></div>
  <div class="scorebox">
    <div class="bignum" id="score">0</div>
    <div class="verdict" id="verdict"></div>
    <div class="bar"><div id="barfill" style="width:0%"></div></div>
    <div style="margin-top:12px"><button class="go" id="export">export audit as markdown</button></div>
    <div class="out" id="out"></div>
  </div>
  <div class="cat" style="margin-top:18px">
    <h3>llms.txt generator</h3>
    <p class="note">Checked the AI-native box above? Emit the file here. <code>llms.txt</code> is a Markdown index AI agents read to navigate your site — title, one-line summary, then grouped links.</p>
    <label class="note" style="display:block;margin-top:10px">site name</label>
    <input id="ll-name" style="width:100%;background:var(--bg);border:1px solid var(--border);border-radius:6px;color:var(--fg);padding:7px;font-size:13px" placeholder="My Project">
    <label class="note" style="display:block;margin-top:8px">one-line summary</label>
    <input id="ll-desc" style="width:100%;background:var(--bg);border:1px solid var(--border);border-radius:6px;color:var(--fg);padding:7px;font-size:13px" placeholder="What it is and why an AI agent would cite it">
    <label class="note" style="display:block;margin-top:8px">links — one per line: <code>section | link text | URL | optional note</code></label>
    <textarea id="ll-links" rows="7" style="width:100%;background:var(--bg);border:1px solid var(--border);border-radius:6px;color:var(--fg);padding:7px;font-size:13px;font-family:ui-monospace,monospace" placeholder="Docs | Getting started | https://example.com/docs | setup in 5 min&#10;API | Endpoint reference | https://example.com/api&#10;Data | Downloads | https://example.com/data | CC0"></textarea>
    <div style="margin-top:10px"><button class="go" id="ll-go">generate llms.txt</button></div>
    <textarea id="ll-out" rows="10" readonly style="width:100%;margin-top:8px;background:var(--bg);border:1px solid var(--border);border-radius:6px;color:var(--fg);padding:7px;font-size:12px;font-family:ui-monospace,monospace" placeholder="llms.txt appears here"></textarea>
  </div>



<script is:inline src="/js/pages/tools/geo.js"></script>
<footer>In-browser only — no tracking, no upload. Part of <a href="https://github.com/zalize-com/trendscope">trendscope</a>.</footer>

</Base>

<style is:global>
:root { --bg:#0d1117; --panel:#161b22; --border:#30363d; --fg:#e6edf3;
          --dim:#8b949e; --accent:#58a6ff; --green:#3fb950; }
  body { background: var(--bg); color: var(--fg);
         font: 14px/1.55 -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
         max-width: 900px; margin: 0 auto; padding: 28px 18px 60px; }
  a { color: var(--accent); text-decoration: none; } a:hover { text-decoration: underline; }
  nav a { color: var(--dim); font-size: 13px; }
  h1 { font-size: 26px; margin: 14px 0 4px; } h1 span { color: var(--accent); }
  .sub { color: var(--dim); margin-bottom: 20px; }
  .cat { background: var(--panel); border: 1px solid var(--border); border-radius: 10px;
         padding: 16px 18px; margin-bottom: 14px; }
  .cat h2 { font-size: 15px; margin-bottom: 8px; }
  .cat h2 em { color: var(--dim); font-style: normal; font-size: 12px; font-weight: normal; }
  .chk { display: flex; gap: 9px; align-items: flex-start; margin: 7px 0; font-size: 13px; cursor: pointer; }
  .chk input { margin-top: 3px; accent-color: var(--green); }
  .chk .w { color: var(--dim); font-size: 11px; }
  .scorebox { background: var(--panel); border: 1px solid var(--border); border-radius: 10px;
              padding: 18px; margin: 18px 0; text-align: center; }
  .bignum { font-size: 44px; font-weight: 700; font-family: ui-monospace, monospace; }
  .verdict { color: var(--dim); font-size: 13px; margin-top: 4px; }
  .bar { height: 8px; background: var(--bg); border-radius: 4px; margin-top: 12px; overflow: hidden; }
  .bar > div { height: 100%; background: var(--green); transition: width .3s; }
  .out { font-family: ui-monospace, monospace; background: var(--bg); border: 1px solid var(--border);
         border-radius: 8px; padding: 10px 12px; margin-top: 10px; word-break: break-word; white-space: pre-wrap;
         font-size: 12px; display: none; }
  button.go { background: var(--panel); color: var(--fg); border: 1px solid var(--accent);
    border-radius: 8px; padding: 8px 18px; font: inherit; font-size: 13px; cursor: pointer; }
  footer { margin-top: 40px; padding-top: 16px; border-top: 1px solid var(--border); color: var(--dim); font-size: 12px; }
  .note { color: var(--dim); font-size: 12px; margin-top: 6px; }
</style>