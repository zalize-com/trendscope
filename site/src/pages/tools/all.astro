---
import Base from "../../layouts/Base.astro";
const title = "all tools — 90+ free client-side developer utilities";
const description = "Searchable index of every trendscope utility: JSON, YAML, regex, cron, JWT, diff, QR, subnet, OPML doctor and 90+ more — all free, all client-side, no signup.";
const path = "/tools/all.html";
---
<Base title={title} description={description} path={path} nav="tools">
<main class="wrap">
  <p class="back"><a href="../index.html">&larr; trendscope</a></p>
  <h1>all tools</h1>
  <p class="muted">90+ free developer utilities &mdash; everything runs locally in your browser. No upload, no signup, no tracking.</p>
  <input id="q" class="q" type="search" placeholder="search tools&hellip; ( / )" autocomplete="off">
  <div id="grid"></div>
</main>
<style is:global>
  .q{width:100%;padding:10px 14px;font-size:15px;border:1px solid var(--pico-muted-border-color,#ccc);border-radius:8px;margin:10px 0 18px;box-sizing:border-box}
  .cat{margin:22px 0 8px;font-size:13px;text-transform:uppercase;letter-spacing:.08em;color:var(--pico-muted-color,#888)}
  .cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:10px}
  .card{position:relative}
  .card a{display:block;padding:12px 14px;border:1px solid var(--pico-muted-border-color,#ddd);border-radius:8px;text-decoration:none;color:inherit;transition:border-color .15s,box-shadow .15s}
  .fav{position:absolute;top:6px;right:6px;z-index:2;border:0;background:none;font-size:15px;line-height:1;color:var(--pico-muted-color,#999);cursor:pointer;padding:2px 4px}
  .fav.on{color:var(--hot)}
  .fav:hover{color:var(--pico-primary,#4a6)}
  .card a:hover{border-color:var(--pico-primary,#4a6);box-shadow:0 1px 6px rgba(0,0,0,.08)}
  .card b{display:block;font-size:14px;margin-bottom:3px}
  .card span{font-size:12.5px;color:var(--pico-muted-color,#777);line-height:1.35;display:block}
  .none{padding:30px 0;color:var(--pico-muted-color,#888)}
</style>
<script is:inline id="tools-data" type="application/json">{"core": [{"name": "JSON formatter", "desc": "Paste JSON → format, minify, or validate.", "href": "index.html#json", "tool": "json"}, {"name": "Regex tester", "desc": "JavaScript flavor. Flags: g i m s u y.", "href": "index.html#regex", "tool": "regex"}, {"name": "Cron explainer", "desc": "Standard 5-field cron (min hour dom mon dow).", "href": "index.html#cron", "tool": "cron"}, {"name": "Timestamp converter", "desc": "Unix seconds/ms ↔ human date (UTC + local).", "href": "index.html#ts", "tool": "ts"}, {"name": "Base64 / URL encoder", "desc": "Unicode-safe. Encode or decode either format.", "href": "index.html#enc", "tool": "enc"}, {"name": "JWT decoder", "desc": "Decodes header + payload locally. Signature is NOT verified.", "href": "index.html#jwt", "tool": "jwt"}, {"name": "Chmod calculator", "desc": "Tick boxes or type a number — both stay in sync.", "href": "index.html#chmod", "tool": "chmod"}, {"name": "UUID & hash", "desc": "Random UUIDs + crypto digests (SHA-1/256/384/512, MD5 not supported by WebCrypto).", "href": "index.html#id", "tool": "id"}], "text & data": [{"name": "Color converter", "desc": "Accepts #hex, rgb(), rgba(), hsl(), named colors.", "href": "utils.html#color", "tool": "color"}, {"name": "Text inspector", "desc": "Counts, case transforms, whitespace cleanup — live as you type.", "href": "utils.html#text", "tool": "text"}, {"name": "YAML ↔ JSON", "desc": "JSON→YAML always runs offline. YAML→JSON uses js-yaml via CDN when available.", "href": "utils.html#yaml", "tool": "yaml"}, {"name": "Outline → tree", "desc": "Indented list (2 spaces or tab per level) → SVG decision tree. Great for branching options.", "href": "utils.html#tree", "tool": "tree"}, {"name": "Contrast checker", "desc": "WCAG 2.1 contrast ratio for text on background — AA needs 4.5:1, AAA 7:1.", "href": "utils.html#contrast", "tool": "contrast"}, {"name": "Slug generator", "desc": "Title → URL-safe slug. Handles accents (Café → cafe), keeps '-' and '_', batch mode = one per line.", "href": "utils.html#slug", "tool": "slug"}, {"name": "URL query editor", "desc": "Paste a URL — inspect and edit its parts, get the rebuilt URL.", "href": "utils.html#url", "tool": "url"}, {"name": "Date calculator", "desc": "Two dates → the span between them (incl./excl.); or a date ± N days → result date. No upload.", "href": "utils.html#date", "tool": "date"}, {"name": "Timezone converter", "desc": "Now, or a datetime — shown across common zones. Pick a zone to see the converted time; all client-side (Intl).", "href": "utils.html#tz", "tool": "tz"}, {"name": "Word frequency", "desc": "Paste text — counts words (case-folded, punctuation stripped). Toggle the stopword filter, export as CSV.", "href": "utils.html#freq", "tool": "freq"}, {"name": "Line ops", "desc": "Paste lines — sort, dedupe, reverse, shuffle, number, or strip whitespace in one click.", "href": "utils.html#lines", "tool": "lines"}, {"name": "OPML → feeds.yaml", "desc": "Paste an OPML export from your RSS reader — get feedpaper feeds.yaml entries.", "href": "utils.html#opml", "tool": "opml"}, {"name": "OPML starter pack", "desc": "Pick lanes from the trendscope registry (9,200+ curated feeds) — get one merged OPML for your reader. Dead/dormant feeds are marked so you only import live ones.", "href": "utils.html#opmlbundle", "tool": "opmlbundle"}, {"name": "CSV ↔ JSON", "desc": "Paste CSV on the left → JSON rows on the right. Paste a JSON array → back to CSV.", "href": "utils.html#csv", "tool": "csv"}, {"name": "password generator", "desc": "crypto.getRandomValues, runs entirely in your browser — nothing is sent anywhere.", "href": "utils.html#pwgen", "tool": "pwgen"}, {"name": "case converter", "desc": "Paste any identifier or text → all naming conventions at once.", "href": "utils.html#case", "tool": "case"}, {"name": "sort & dedupe lines", "desc": "Paste lines → sorted/deduped/reversed/shuffled out.", "href": "utils.html#sortlines", "tool": "sortlines"}, {"name": "uuid v4 generator", "desc": "Random UUIDs from crypto.randomUUID() (CSPRNG), batch of N.", "href": "utils.html#uuid", "tool": "uuid"}, {"name": "file-size unit converter", "desc": "Bytes ↔ KB/MB/GB (SI 1000) ↔ KiB/MiB/GiB (IEC 1024), plus bit-rate.", "href": "utils.html#bytes", "tool": "bytes"}, {"name": "lorem ipsum generator", "desc": "Placeholder text: N paragraphs or words, classic or silly.", "href": "utils.html#lorem", "tool": "lorem"}, {"name": "aspect ratio calculator", "desc": "W:H ratio ↔ missing dimension ↔ CSS padding trick.", "href": "utils.html#aspect", "tool": "aspect"}, {"name": "morse code converter", "desc": "Text ↔ Morse (dot/dash, / = word space). A-Z 0-9 + common punctuation.", "href": "utils.html#morse", "tool": "morse"}, {"name": "roman numeral converter", "desc": "1-3999 ↔ I-MMMCMXCIX, strict validation.", "href": "utils.html#roman", "tool": "roman"}, {"name": "mime type ↔ extension", "desc": "Filter the table — or paste a filename / mime type. Common web dev types.", "href": "utils.html#mime", "tool": "mime"}, {"name": "semver sort & compare", "desc": "One version per line → sorted. Or two versions to compare. Powered by compare-versions.", "href": "utils.html#semver", "tool": "semver"}], "docs & diff": [{"name": "Text diff", "desc": "Line-based diff (LCS). Paste the original on the left, the new version on the right.", "href": "more.html#diff", "tool": "diff"}, {"name": "Markdown preview", "desc": "Live preview. Supports headings, bold/italic/code, lists, tables, links, quotes, fences.", "href": "more.html#md", "tool": "md"}, {"name": "Markdown table builder", "desc": "Paste TSV/CSV (e.g. straight from Excel/Sheets) → aligned Markdown table with header row.", "href": "more.html#mdtable", "tool": "mdtable"}, {"name": "Unicode inspector", "desc": "Paste any text — per-character codepoint, UTF-8 bytes, UTF-16 units, block and category.", "href": "more.html#uni", "tool": "uni"}, {"name": "AI-text tells", "desc": "Heuristic signals common in LLM-written prose — telltale words, em-dash density, uniform sentence length, formulaic transitions. Not a detector: humans write these too. Highlights what it flags.", "href": "more.html#aitext", "tool": "aitext"}, {"name": "Markdown TOC generator", "desc": "Paste markdown — get a table of contents with GitHub-style anchor links. Depth limit optional.", "href": "more.html#toc", "tool": "toc"}, {"name": "HTML → Markdown", "desc": "Paste HTML — get clean Markdown. Handles headings, links, lists, code, tables, quotes, images.", "href": "more.html#html2md", "tool": "html2md"}], "dev/JSON": [{"name": "JSON query — jq-lite", "desc": "Path syntax: .a.b[0], .items[] (all elements), .* (all values). One result per line, JSON-encoded.", "href": "dev.html#jq", "tool": "jq"}, {"name": "IPv4 subnet calculator", "desc": "CIDR or IP/prefix, e.g. 10.0.0.17/24 or 192.168.1.0/26.", "href": "dev.html#subnet", "tool": "subnet"}, {"name": "Number base converter", "desc": "Type in any field; the others update. Unsigned integers.", "href": "dev.html#base", "tool": "base"}, {"name": "Password generator", "desc": "crypto.getRandomValues — never leaves the browser.", "href": "dev.html#pw", "tool": "pw"}, {"name": "JSON → JSON Schema", "desc": "Paste a JSON sample — infers a draft-2020-12 schema (types, required keys, array item schemas, enums for small string sets).", "href": "dev.html#schema", "tool": "schema"}, {"name": ".gitignore generator", "desc": "Pick the languages/OS/IDEs in your stack — combined template outputs below.", "href": "dev.html#gi", "tool": "gi"}, {"name": "curl → fetch / requests", "desc": "Paste a curl command (with or without curl prefix). Emits JS fetch() and Python requests equivalents. Supports -X/-H/-d/--data*/-u/-A/-G/-F/--compressed.", "href": "dev.html#curl", "tool": "curl"}, {"name": "Hidden character inspector", "desc": "Paste text that came from somewhere else — finds zero-width chars, bidi controls, non-breaking/exotic spaces, soft hyphens and lookalike non-ASCII letters (common in copy-paste attacks and broken diffs).", "href": "dev.html#hidden", "tool": "hidden"}, {"name": "Keyboard key inspector", "desc": "Click the box, then press any key — shows event.key, code, which and modifiers. Recent keys below.", "href": "dev.html#keys", "tool": "keys"}, {"name": "JSON diff", "desc": "Paste two JSON values — path-level diff (added / removed / changed). Objects compared recursively; arrays by index.", "href": "dev.html#jdiff", "tool": "jdiff"}, {"name": ".env file auditor", "desc": "Paste a .env — flags keys that look like real secrets, duplicates and placeholders. Nothing leaves the page.", "href": "dev.html#env", "tool": "env"}, {"name": "HTML entity encoder / decoder", "desc": "Encode text for safe embedding (& < > \" ' → entities) or decode entities back. Catches the double-encoding bug class too.", "href": "dev.html#ent", "tool": "ent"}, {"name": "conventional-commit checker", "desc": "Validate a commit message against the Conventional Commits spec — type(scope)!: description, with hints when it fails.", "href": "dev.html#ccommit", "tool": "ccommit"}, {"name": "file → data URI", "desc": "Drop or pick a file — get a base64 data URI you can inline in CSS/HTML/markdown. Files up to ~2 MB work smoothly.", "href": "dev.html#datauri", "tool": "datauri"}, {"name": "LLM API cost estimator", "desc": "Estimate monthly spend per model from your usage shape. Prices are approximate public list prices (per 1M tokens, USD) — verify on provider pricing pages before budgeting.", "href": "dev.html#llmcost", "tool": "llmcost"}, {"name": "CSV profiler", "desc": "Paste CSV/TSV — per-column profile: type guess, fill rate, unique count, top values, min/max/mean for numerics.", "href": "dev.html#csvprof", "tool": "csvprof"}, {"name": "MCP server config validator", "desc": "Paste an mcp.json / claude_desktop_config.json — validates each server entry: stdio needs command, remote needs url, flags inline secrets and unpinned packages.", "href": "dev.html#mcp", "tool": "mcp"}, {"name": "SQL formatter", "desc": "Paste SQL — keywords uppercased, major clauses break to new lines, indent for subqueries and JOIN chains.", "href": "dev.html#sql", "tool": "sql"}, {"name": "Base64 / data URI → file", "desc": "Paste base64 or a full data:…;base64, URI — reconstructs the file locally and downloads it. Nothing leaves the browser.", "href": "dev.html#b64file", "tool": "b64file"}, {"name": "ASCII table", "desc": "All 128 ASCII codes — searchable by char, code, hex or name.", "href": "dev.html#ascii", "tool": "ascii"}, {"name": "JSON → Go struct", "desc": "Paste a JSON sample — generates Go struct definitions with json: tags (nested structs, slices, optional→pointer-free by default).", "href": "dev.html#gostruct", "tool": "gostruct"}, {"name": "JWT signer (HS256)", "desc": "Signs a JWT with HMAC-SHA256 in your browser via WebCrypto — the secret never leaves this page. Pairs with the JWT decoder.", "href": "dev.html#jwtsign", "tool": "jwtsign"}, {"name": "JSON → SQL", "desc": "Paste a JSON array of objects — infers a CREATE TABLE (portable types) plus INSERT rows.", "href": "dev.html#jsonsql", "tool": "jsonsql"}], "web & SEO": [{"name": "QR code generator", "desc": "URL or any text → downloadable PNG. Everything happens in your browser.", "href": "web.html#qr", "tool": "qr"}, {"name": "Social card preview + meta tags", "desc": "Fill in, see how the link card renders, copy the meta block.", "href": "web.html#og", "tool": "og"}, {"name": "robots.txt builder", "desc": "Pick rules per bot, add a sitemap, copy the file into your repo root.", "href": "web.html#robots", "tool": "robots"}, {"name": "Typosquat generator + checker", "desc": "Enter a domain → common lookalike registrations an impersonator might grab. Click any candidate to look it up.", "href": "web.html#squat", "tool": "squat"}, {"name": "HTTP status codes", "desc": "Search by code or word. Click a row for the MDN page.", "href": "web.html#http", "tool": "http"}, {"name": "File checksum", "desc": "Pick or drop a file — SHA-256/SHA-1 computed locally via WebCrypto. Nothing is uploaded.", "href": "web.html#hash", "tool": "hash"}, {"name": "Social card audit", "desc": "Paste a page's <head> (or full HTML) — extracts Open Graph / Twitter / standard meta, renders the share preview, and lists what's missing.", "href": "web.html#meta", "tool": "meta"}, {"name": "AI-free badge", "desc": "Declare your site is human-made. Pick a label + style, copy the SVG or HTML snippet.", "href": "web.html#aifree", "tool": "aifree"}, {"name": "UTM builder", "desc": "", "href": "web.html#utm", "tool": "utm"}, {"name": "px ↔ rem converter", "desc": "Type either side — converts at the base font-size below. Common values on the right.", "href": "web.html#pxrem", "tool": "pxrem"}, {"name": "AI-crawler robots.txt checker", "desc": "Paste your robots.txt — see which AI crawlers you allow or block. GEO starts here: a blocked GPTBot can never cite you.", "href": "web.html#aibots", "tool": "aibots"}, {"name": "status-page checker", "desc": "Paste any statuspage.io URL (e.g. https://status.openai.com) — live incidents and degraded components, straight from the source. Presets: github · openai · cloudflare", "href": "web.html#spage", "tool": "spage"}, {"name": "RSS / Atom feed finder", "desc": "Paste a page's HTML source (Ctrl+U → copy) — finds declared <link rel=\"alternate\"> feeds and guesses well-known paths. Browsers can't fetch cross-origin, so HTML paste is the reliable route.", "href": "web.html#feed", "tool": "feed"}, {"name": "shields.io badge builder", "desc": "Make a shields badge without reading the URL format — label, color, icon, style; get markdown + HTML to paste into a README.", "href": "web.html#badge", "tool": "badge"}, {"name": "OG image sizer", "desc": "Drop or pick an image — center-crop to 1200×630 (og:image standard), download PNG. Everything stays in your browser.", "href": "web.html#ogimg", "tool": "ogimg"}, {"name": "Web app manifest builder", "desc": "Generate a manifest.json — pair with the favicon pack for installable apps.", "href": "web.html#manifest", "tool": "manifest"}, {"name": "SERP + social card preview", "desc": "Paste a page's <head> (or fetch a URL) — see how it renders as a Google result and a social card.", "href": "web.html#serp", "tool": "serp"}, {"name": "Favicon pack", "desc": "Upload a square-ish image — get all standard favicon sizes as PNGs plus the manifest snippet, generated locally.", "href": "web.html#favicon", "tool": "favicon"}, {"name": "sitemap.xml generator", "desc": "One URL per line. Optional: url, lastmod, priority (comma-separated).", "href": "web.html#sitemapgen", "tool": "sitemapgen"}, {"name": "llms.txt generator", "desc": "Generate an llms.txt file so AI crawlers understand your site. One link per line: title | url | note(optional).", "href": "web.html#llmstxt", "tool": "llmstxt"}], "audit": [{"name": "Accessibility audit", "desc": "10 rule classes — images, contrast, ARIA, landmarks", "href": "a11y.html", "tool": ""}, {"name": "GEO/AI-visibility audit", "desc": "robots.txt, JSON-LD, llms.txt — is your site legible to AI?", "href": "geo.html", "tool": ""}], "extensions": [{"name": "MV2 extension replacements", "desc": "Dead Chrome extensions → the web tools that replace them", "href": "extensions.html", "tool": ""}], "feeds": [{"name": "OPML doctor", "desc": "Feed-list health check: alive / moved / dormant / dead + fixed OPML", "href": "doctor.html", "tool": ""}, {"name": "Feed directory", "desc": "9,200+ curated feeds by lane with live health status", "href": "../feeds.html", "tool": ""}]}</script>

<script is:inline src="/js/pages/tools/all.js"></script>
</Base>
