---
import Base from "../../layouts/Base.astro";
const title = "trendscope tools \u2014 free in-browser developer utilities";
const description = "Free developer tools that run entirely in your browser: JSON formatter, regex tester, cron explainer, timestamp converter, Base64/URL encoder. No upload, no signup, no tracking.";
const path = '/tools/index.html';
---
<Base title={title} description={description} path={path} nav="tools">

<div class="wrap">
  <a class="back" href="../index.html">← trendscope dashboard</a>
  <h1>tools</h1>
  <p class="sub">91 utilities across 7 pages, 100% client-side. No upload, no signup, no tracking.
    &nbsp;·&nbsp;<a href="all.html" style="color:var(--accent)"><b>all tools — searchable index →</b></a>&nbsp;·&nbsp;<a href="more.html" style="color:var(--accent)">more: text diff + markdown preview →</a>&nbsp;·&nbsp;<a href="utils.html" style="color:var(--accent)">utils: color, text, YAML, tree, URL, contrast →</a>&nbsp;·&nbsp;<a href="dev.html" style="color:var(--accent)">dev: subnet, base, password, CSV↔JSON, schema →</a>&nbsp;·&nbsp;<a href="web.html" style="color:var(--accent)">web: QR, social card, robots.txt →</a>&nbsp;·&nbsp;<a href="a11y.html" style="color:var(--accent)">a11y audit →</a>&nbsp;·&nbsp;<a href="geo.html" style="color:var(--accent)">geo audit →</a>&nbsp;·&nbsp;<a href="extensions.html" style="color:var(--accent)">MV2 extension replacements →</a>&nbsp;·&nbsp;<a href="doctor.html" style="color:var(--accent)">OPML doctor →</a></p>

  <div class="tabs" id="tabs"></div>

  <!-- JSON -->
  <div class="tool" data-tool="json">
    <h2>JSON formatter</h2>
    <p class="hint">Paste JSON → format, minify, or validate.</p>
    <textarea id="json-in" placeholder='&#123;"a":1,"b":[2,3]&#125;'></textarea>
    <div class="btns">
      <button class="act" onclick="jsonDo('pretty')">Format</button>
      <button class="act" onclick="jsonDo('minify')">Minify</button>
      <button class="act" onclick="jsonDo('validate')">Validate</button>
    </div>
    <div class="out" id="json-out"></div>
  </div>

  <!-- Regex -->
  <div class="tool" data-tool="regex">
    <h2>Regex tester</h2>
    <p class="hint">JavaScript flavor. Flags: g i m s u y.</p>
    <input type="text" id="re-pat" placeholder="pattern, e.g. \b\w+@\w+\.\w+\b">
    <div style="height:8px"></div>
    <input type="text" id="re-flags" placeholder="flags (default: g)">
    <div style="height:8px"></div>
    <textarea id="re-text" placeholder="test string…"></textarea>
    <div class="out" id="re-out"></div>
  </div>

  <!-- Cron -->
  <div class="tool" data-tool="cron">
    <h2>Cron explainer</h2>
    <p class="hint">Standard 5-field cron (min hour dom mon dow).</p>
    <input type="text" id="cron-in" placeholder="e.g. 5 6 * * 1-5">
    <div class="btns"><button class="act" onclick="cronGo()">Explain</button></div>
    <div class="out" id="cron-out"></div>
  </div>

  <!-- Timestamp -->
  <div class="tool" data-tool="ts">
    <h2>Timestamp converter</h2>
    <p class="hint">Unix seconds/ms ↔ human date (UTC + local).</p>
    <div class="grid">
      <div class="cell"><div class="k">now (unix s)</div><div class="v" id="ts-now"></div></div>
      <div class="cell"><div class="k">now (UTC)</div><div class="v" id="ts-utc"></div></div>
    </div>
    <div style="height:12px"></div>
    <input type="text" id="ts-in" placeholder="unix seconds or ISO date, e.g. 1731700000 or 2026-11-15T04:00:00Z">
    <div class="btns"><button class="act" onclick="tsGo()">Convert</button></div>
    <div class="grid" id="ts-out"></div>
  </div>

  <!-- Base64 / URL -->
  <div class="tool" data-tool="enc">
    <h2>Base64 / URL encoder</h2>
    <p class="hint">Unicode-safe. Encode or decode either format.</p>
    <textarea id="enc-in" placeholder="text or base64 or %encoded"></textarea>
    <div class="btns">
      <button class="act" onclick="encDo('b64e')">→ Base64</button>
      <button class="act" onclick="encDo('b64d')">Base64 →</button>
      <button class="act" onclick="encDo('urle')">→ URL-encoded</button>
      <button class="act" onclick="encDo('urld')">URL-decoded →</button>
    </div>
    <div class="out" id="enc-out"></div>
  </div>

  <!-- JWT -->
  <div class="tool" data-tool="jwt">
    <h2>JWT decoder</h2>
    <p class="hint">Decodes header + payload locally. Signature is NOT verified.</p>
    <textarea id="jwt-in" placeholder="eyJhbGciOi…"></textarea>
    <div class="out" id="jwt-out"></div>
  </div>

  <!-- Chmod -->
  <div class="tool" data-tool="chmod">
    <h2>Chmod calculator</h2>
    <p class="hint">Tick boxes or type a number — both stay in sync.</p>
    <div id="chmod-grid"></div>
    <div class="btns"></div>
    <input type="text" id="chmod-num" placeholder="e.g. 755" maxlength="4">
    <div class="out" id="chmod-out"></div>
  </div>

  <!-- UUID / hash -->
  <div class="tool" data-tool="id">
    <h2>UUID &amp; hash</h2>
    <p class="hint">Random UUIDs + crypto digests (SHA-1/256/384/512, MD5 not supported by WebCrypto).</p>
    <div class="btns">
      <button class="act" onclick="uuidGo(1)">UUID ×1</button>
      <button class="act" onclick="uuidGo(5)">UUID ×5</button>
      <button class="act" onclick="hashGo('SHA-256')">SHA-256</button>
      <button class="act" onclick="hashGo('SHA-1')">SHA-1</button>
      <button class="act" onclick="hashGo('SHA-512')">SHA-512</button>
    </div>
    <textarea id="hash-in" placeholder="text to hash…"></textarea>
    <div class="out" id="id-out"></div>
  </div>

  
</div>



<script is:inline src="/js/pages/tools/index.js"></script>
<footer>
    Part of <a href="../index.html">trendscope</a> — the daily developer attention dataset.
    Source: <a href="https://github.com/zalize-com/trendscope">github.com/zalize-com/trendscope</a>
  </footer>

</Base>

<style is:global>
:root {
    --bg: #0d1117; --panel: #161b22; --border: #30363d; --fg: #e6edf3;
    --dim: #8b949e; --accent: #58a6ff; --green: #3fb950; --red: #f85149;
  }
  @media (prefers-color-scheme: light) {
  :root:not([data-theme]) { --bg: #f6f8fa; --panel: #ffffff; --border: #d0d7de; --fg: #1f2328;
      --dim: #59636e; --accent: #0969da; --green: #1a7f37; --red: #cf222e; }
}
html[data-theme="light"] { --bg: #f6f8fa; --panel: #ffffff; --border: #d0d7de; --fg: #1f2328;
      --dim: #59636e; --accent: #0969da; --green: #1a7f37; --red: #cf222e; }
  body {
    background: var(--bg); color: var(--fg);
    font: 15px/1.55 -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
  }
  .wrap { max-width: 900px; margin: 0 auto; padding: 28px 18px 60px; }
  a.back { color: var(--accent); text-decoration: none; font-size: 14px; }
  h1 { font-size: 26px; margin: 14px 0 4px; }
  .sub { color: var(--dim); font-size: 14px; }
  .tabs { display: flex; flex-wrap: wrap; gap: 6px; margin: 20px 0 16px; }
  .tab {
    padding: 7px 14px; border-radius: 8px; border: 1px solid var(--border);
    background: var(--panel); color: var(--dim); cursor: pointer; font-size: 14px;
  }
  .tool { display: none; }
  .tool.active { display: block; }
  h2 { font-size: 18px; margin-bottom: 4px; }
  .hint { color: var(--dim); font-size: 13px; margin-bottom: 12px; }
  textarea, input[type=text], input[type=number] {
    width: 100%; padding: 10px 12px; border-radius: 8px; font-size: 14px;
    border: 1px solid var(--border); background: var(--panel); color: var(--fg);
    font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, monospace;
  }
  textarea { min-height: 140px; resize: vertical; }
  .row2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  @media (max-width: 640px) { .row2 { grid-template-columns: 1fr; } }
  .btns { display: flex; gap: 8px; margin: 10px 0; flex-wrap: wrap; }
  button.act {
    padding: 8px 16px; border-radius: 8px; border: 1px solid var(--accent);
    background: transparent; color: var(--accent); cursor: pointer; font-size: 14px;
  }
  button.act:hover { background: var(--accent); color: var(--bg); }
  .out {
    background: var(--panel); border: 1px solid var(--border); border-radius: 8px;
    padding: 12px 14px; font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 13px; white-space: pre-wrap; word-break: break-all; min-height: 60px;
  }
  .ok { color: var(--green); }
  .bad { color: var(--red); }
  mark { background: var(--orange, #d29922); color: #fff; border-radius: 3px; padding: 0 1px; }
  :root { --orange: #d29922; }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px,1fr)); gap: 10px; margin-top: 10px; }
  .cell { background: var(--panel); border: 1px solid var(--border); border-radius: 8px; padding: 10px 12px; }
  .cell .k { color: var(--dim); font-size: 12px; }
  .cell .v { font-family: ui-monospace, Menlo, monospace; font-size: 15px; margin-top: 2px; }
  footer { margin-top: 40px; color: var(--dim); font-size: 13px; border-top: 1px solid var(--border); padding-top: 14px; }
  footer a { color: var(--accent); }
</style>