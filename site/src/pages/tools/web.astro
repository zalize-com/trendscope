---
import Base from "../../layouts/Base.astro";
const title = "trendscope web tools \u2014 QR generator, social card preview, robots.txt builder";
const description = "Free in-browser web tools: QR code generator, Open Graph/Twitter card preview + meta tag generator, robots.txt builder, and a typosquat checker. No upload, no signup, no tracking.";
const path = '/tools/web.html';
---
<Base title={title} description={description} path={path} nav="tools">

<nav><a href="../index.html">← trendscope</a> · <a href="./">tools</a> · <a href="more.html">tools+</a> · <a href="utils.html">utils</a> · <a href="dev.html">dev</a> · <a href="a11y.html">a11y</a> · <a href="geo.html">geo</a> · <a href="extensions.html">ext?</a></nav>
  <h1>web<span> tools</span></h1>
  <p class="sub">QR codes · social card · robots.txt · typosquat check — all client-side.</p>
  <div class="tabs" id="tabs">
    <button data-tool="qr">QR code</button>
    <button data-tool="og">social card</button>
    <button data-tool="robots">robots.txt</button>
    <button data-tool="squat">typosquat</button>
    <button data-tool="http">HTTP status</button>
    <button data-tool="hash">file checksum</button>
    <button data-tool="pxrem">px ↔ rem</button>
    <button data-tool="utm">UTM builder</button>
    <button data-tool="aifree">AI-free badge</button>
    <button data-tool="meta">meta audit</button>
    <button data-tool="aibots">AI bots</button>
    <button data-tool="spage">status page</button>
    <button data-tool="feed">feed finder</button>
    <button data-tool="badge">badge builder</button>
    <button data-tool="ogimg">og image</button>
    <button data-tool="favicon">favicon pack</button>
    <button data-tool="sitemapgen">sitemap.xml</button>
    <button data-tool="llmstxt">llms.txt</button>
    <button data-tool="manifest">manifest.json</button>
    <button data-tool="serp">SERP preview</button>
  </div>

  <div class="panel" id="p-qr">
    <h2>QR code generator</h2>
    <p class="hint">URL or any text → downloadable PNG. Everything happens in your browser.</p>
    <input type="text" id="qr-in" placeholder="https://example.com" value="https://github.com/zalize-com/trendscope">
    <div class="row" style="margin-top:10px">
      <div><label>size (px)</label><select id="qr-size"><option>256</option><option selected>512</option><option>1024</option></select></div>
      <div><label>error correction</label><select id="qr-ecc"><option>L</option><option selected>M</option><option>Q</option><option>H</option></select></div>
    </div>
    <div id="qr-box" style="margin-top:14px;text-align:center"></div>
    <div id="qr-dl"></div>
    <div class="err" id="qr-err"></div>
  </div>

  <div class="panel" id="p-og">
    <h2>Social card preview + meta tags</h2>
    <p class="hint">Fill in, see how the link card renders, copy the meta block.</p>
    <label>title</label><input type="text" id="og-t" value="trendscope — developer attention dataset">
    <label>description</label><input type="text" id="og-d" value="Daily cross-source snapshot of what developers read and build. Open data, CC0.">
    <label>canonical URL</label><input type="text" id="og-u" value="https://trendscope--plov6nur.preview.devinapps.com/">
    <label>image URL</label><input type="text" id="og-i" value="https://trendscope--plov6nur.preview.devinapps.com/og.jpg">
    <div class="card" id="og-card">
      <div class="img" id="og-card-img">image preview</div>
      <div class="txt"><div class="dom" id="og-card-dom"></div><div class="ttl" id="og-card-t"></div><div class="dsc" id="og-card-d"></div></div>
    </div>
    <div class="out" id="og-out"></div>
    <button class="copy" id="og-copy">copy meta tags</button>
  </div>

  <div class="panel" id="p-robots">
    <h2>robots.txt builder</h2>
    <p class="hint">Pick rules per bot, add a sitemap, copy the file into your repo root.</p>
    <label class="chk"><input type="checkbox" id="rb-all" checked> allow all crawlers (User-agent: *)</label>
    <label>disallow paths for * (one per line)</label>
    <textarea id="rb-dis" rows="3" placeholder="/admin/&#10;/tmp/"></textarea>
    <label>sitemap URL</label><input type="text" id="rb-map" placeholder="https://example.com/sitemap.xml">
    <label>extra bot blocks (e.g. "GPTBot: /")</label>
    <textarea id="rb-extra" rows="2" placeholder="GPTBot: /&#10;CCBot: /"></textarea>
    <div class="out" id="rb-out"></div>
    <button class="copy" id="rb-copy">copy robots.txt</button>
  </div>

    <div class="panel" id="p-squat">
    <h2>Typosquat generator + checker</h2>
    <p class="hint">Enter a domain → common lookalike registrations an impersonator might grab. Click any candidate to look it up.</p>
    <input type="text" id="sq-in" placeholder="example.com" value="example.com">
    <div class="out" id="sq-out" style="margin-top:12px"></div>
  </div>

  <div class="panel" id="p-http">
    <h2>HTTP status codes</h2>
    <p class="hint">Search by code or word. Click a row for the MDN page.</p>
    <input type="text" id="ht-in" placeholder="e.g. 429 or rate limit">
    <div id="ht-out" style="margin-top:12px"></div>
  </div>
  <div class="panel" id="p-hash">
    <h2>File checksum</h2>
    <p class="hint">Pick or drop a file — SHA-256/SHA-1 computed locally via WebCrypto. Nothing is uploaded.</p>
    <input type="file" id="hs-in">
    <div id="hs-drop" style="margin:10px 0;padding:18px;border:1px dashed var(--border);border-radius:8px;color:var(--dim);text-align:center">…or drop a file here</div>
    <div id="hs-out" style="margin-top:8px"></div>
  </div>

  <div class="panel" id="p-meta">
    <h2>Social card audit</h2>
    <p class="hint">Paste a page's <code>&lt;head&gt;</code> (or full HTML) — extracts Open Graph / Twitter / standard meta, renders the share preview, and lists what's missing.</p>
    <textarea id="ma-in" rows="7" style="width:100%" placeholder="<head>…<meta property=\"og:title\" …>"></textarea>
    <p><button class="btn" id="ma-go">audit</button></p>
    <div id="ma-out"></div>
  </div>
  <div class="panel" id="p-aifree">
    <h2>AI-free badge</h2>
    <p class="hint">Declare your site is human-made. Pick a label + style, copy the SVG or HTML snippet.</p>
    <label>label</label>
    <select id="af-label">
      <option>made by humans</option>
      <option>100% human-written</option>
      <option>no AI used here</option>
      <option>handcrafted, no LLM</option>
    </select>
    <label>style</label>
    <select id="af-style">
      <option value="dark">dark</option>
      <option value="light">light</option>
      <option value="outline">outline</option>
    </select>
    <div id="af-view" style="margin:12px 0"></div>
    <div class="out" id="af-out"></div>
    <button class="copy" id="af-copy">copy snippet</button>
  </div>
  <div class="panel" id="p-utm">
    <h2>UTM builder</h2>
    <label>URL <input id="ut-url" placeholder="https://example.com/page" style="width:100%"></label>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:8px 0">
      <label>utm_source <input id="ut-source" placeholder="newsletter"></label>
      <label>utm_medium <input id="ut-medium" placeholder="email"></label>
      <label>utm_campaign <input id="ut-campaign" placeholder="launch_2026"></label>
      <label>utm_term <input id="ut-term" placeholder="(optional)"></label>
      <label>utm_content <input id="ut-content" placeholder="(optional)"></label>
    </div>
    <textarea id="ut-out" readonly rows="3" style="width:100%" placeholder="tagged URL appears here"></textarea>
    <p><button class="btn" onclick="navigator.clipboard.writeText(document.getElementById('ut-out').value)">copy</button></p>
  </div>
  <div class="panel" id="p-pxrem">
    <h2>px ↔ rem converter</h2>
    <p class="hint">Type either side — converts at the base font-size below. Common values on the right.</p>
    <div style="display:flex;gap:10px;align-items:baseline;flex-wrap:wrap">
      <input type="number" id="px" placeholder="px" step="any" style="width:110px"> <span style="color:var(--dim)">px =</span>
      <input type="number" id="rm" placeholder="rem" step="any" style="width:110px"> <span style="color:var(--dim)">rem</span>
      <span style="color:var(--dim)">· base</span>
      <input type="number" id="base" value="16" step="any" style="width:70px"> <span style="color:var(--dim)">px</span>
    </div>
    <div id="pr-table" style="margin-top:12px"></div>
  </div>


  <div class="panel" id="p-aibots">
    <h2>AI-crawler robots.txt checker</h2>
    <p class="hint">Paste your robots.txt — see which AI crawlers you allow or block. GEO starts here: a blocked GPTBot can never cite you.</p>
    <textarea id="ab-in" rows="7" placeholder="User-agent: *&#10;Disallow: /private/&#10;&#10;User-agent: GPTBot&#10;Disallow: /"></textarea>
    <div id="ab-out" style="margin-top:10px"></div>
  </div>

  <div class="panel" id="p-spage">
    <h2>status-page checker</h2>
    <p class="hint">Paste any statuspage.io URL (e.g. <code>https://status.openai.com</code>) — live incidents and degraded components, straight from the source. Presets: <a href="?t=spage" onclick="return spreset('https://www.githubstatus.com')">github</a> · <a href="?t=spage" onclick="return spreset('https://status.openai.com')">openai</a> · <a href="?t=spage" onclick="return spreset('https://www.cloudflarestatus.com')">cloudflare</a></p>
    <input id="sp-in" placeholder="https://status.example.com" value="https://status.openai.com" style="width:100%;padding:8px;border-radius:8px;border:1px solid var(--border);background:var(--bg);color:var(--fg)">
    <div id="sp-out" style="margin-top:10px"></div>
  </div>

  <div class="panel" id="p-feed">
    <h2>RSS / Atom feed finder</h2>
    <p class="hint">Paste a page's HTML source (Ctrl+U → copy) — finds declared <code>&lt;link rel="alternate"&gt;</code> feeds and guesses well-known paths. Browsers can't fetch cross-origin, so HTML paste is the reliable route.</p>
    <input id="fd-base" placeholder="site URL, e.g. https://simonwillison.net" style="width:100%;padding:8px;border-radius:8px;border:1px solid var(--border);background:var(--bg);color:var(--fg)">
    <textarea id="fd-in" placeholder="paste the page's &lt;head&gt; source here…" style="width:100%;height:110px;margin-top:6px"></textarea>
    <div id="fd-out" style="margin-top:10px"></div>
  </div>

  <div class="panel" id="p-badge">
    <h2>shields.io badge builder</h2>
    <p class="hint">Make a <a href="https://shields.io" target="_blank" rel="noopener">shields</a> badge without reading the URL format — label, color, icon, style; get markdown + HTML to paste into a README.</p>
    <div style="display:flex;gap:8px;flex-wrap:wrap">
      <input id="bd-label" value="status" placeholder="label" style="flex:1;min-width:100px;padding:8px;border-radius:8px;border:1px solid var(--border);background:var(--bg);color:var(--fg)">
      <input id="bd-msg" value="live" placeholder="message" style="flex:1;min-width:100px;padding:8px;border-radius:8px;border:1px solid var(--border);background:var(--bg);color:var(--fg)">
      <input id="bd-color" value="brightgreen" placeholder="color / hex" style="flex:1;min-width:90px;padding:8px;border-radius:8px;border:1px solid var(--border);background:var(--bg);color:var(--fg)">
      <select id="bd-style" style="padding:8px;border-radius:8px;border:1px solid var(--border);background:var(--bg);color:var(--fg)">
        <option value="flat">flat</option><option value="flat-square">flat-square</option><option value="for-the-badge">for-the-badge</option><option value="social">social</option><option value="plastic">plastic</option>
      </select>
    </div>
    <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:6px">
      <input id="bd-logo" placeholder="icon, e.g. github (optional — simple-icons slug)" style="flex:1;min-width:160px;padding:8px;border-radius:8px;border:1px solid var(--border);background:var(--bg);color:var(--fg)">
      <input id="bd-link" placeholder="link URL (optional — click target)" style="flex:2;min-width:200px;padding:8px;border-radius:8px;border:1px solid var(--border);background:var(--bg);color:var(--fg)">
    </div>
    <div id="bd-out" style="margin-top:10px"></div>
  </div>

  <div class="panel" id="p-ogimg">
    <h2>OG image sizer</h2>
    <p class="hint">Drop or pick an image — center-crop to 1200×630 (og:image standard), download PNG. Everything stays in your browser.</p>
    <input type="file" id="ogimg-file" accept="image/*" style="font-size:13px">
    <div id="ogimg-drop" style="margin:10px 0;padding:26px;border:2px dashed var(--border);border-radius:10px;text-align:center;color:var(--dim);font-size:13px">…or drag an image here</div>
    <canvas id="ogimg-cv" width="1200" height="630" style="max-width:100%;border:1px solid var(--border);border-radius:8px;display:none"></canvas>
    <div style="margin-top:8px"><button id="ogimg-dl" style="display:none">download og.png</button> <span class="hint" id="ogimg-info"></span></div>
  </div>


<div class="panel" id="p-manifest">
    <h2>Web app manifest builder</h2>
    <p class="hint">Generate a <code>manifest.json</code> — pair with the <a href="?t=favicon">favicon pack</a> for installable apps.</p>
    <div class="kv" style="display:grid;grid-template-columns:150px 1fr;gap:6px 10px;margin-bottom:8px">
      <span class="muted" style="align-self:center">name</span><input id="mf-name" placeholder="My App" style="padding:7px 10px;border-radius:8px;border:1px solid var(--border);background:var(--bg);color:var(--fg)">
      <span class="muted" style="align-self:center">short_name</span><input id="mf-short" placeholder="App" style="padding:7px 10px;border-radius:8px;border:1px solid var(--border);background:var(--bg);color:var(--fg)">
      <span class="muted" style="align-self:center">start_url</span><input id="mf-start" placeholder="/" style="padding:7px 10px;border-radius:8px;border:1px solid var(--border);background:var(--bg);color:var(--fg)">
      <span class="muted" style="align-self:center">display</span><select id="mf-display" style="padding:7px 10px;border-radius:8px;border:1px solid var(--border);background:var(--bg);color:var(--fg)"><option>standalone</option><option>browser</option><option>minimal-ui</option><option>fullscreen</option></select>
      <span class="muted" style="align-self:center">theme_color</span><input id="mf-theme" placeholder="#0d1117" style="padding:7px 10px;border-radius:8px;border:1px solid var(--border);background:var(--bg);color:var(--fg)">
      <span class="muted" style="align-self:center">background_color</span><input id="mf-bg" placeholder="#0d1117" style="padding:7px 10px;border-radius:8px;border:1px solid var(--border);background:var(--bg);color:var(--fg)">
      <span class="muted" style="align-self:center">icons</span><input id="mf-icons" placeholder="favicon-16.png,android-chrome-192.png,android-chrome-512.png" style="padding:7px 10px;border-radius:8px;border:1px solid var(--border);background:var(--bg);color:var(--fg)">
    </div>
    <div class="out" id="mf-out" style="white-space:pre;overflow-x:auto"></div>
    <button class="copy" id="mf-copy">copy manifest.json</button>
    <div class="err" id="mf-err"></div>
  </div>

  <div class="panel" id="p-serp">
    <h2>SERP + social card preview</h2>
    <p class="hint">Paste a page's <code>&lt;head&gt;</code> (or fetch a URL) — see how it renders as a Google result and a social card.</p>
    <input id="sv-url" placeholder="https://example.com (fetch head)" style="width:58%;padding:8px;border-radius:8px;border:1px solid var(--border);background:var(--bg);color:var(--fg)">
    <button id="sv-go" class="copy" style="vertical-align:baseline">fetch</button>
    <textarea id="sv-in" rows="5" placeholder="<head><title>…</title><meta name=&quot;description&quot; content=&quot;…&quot;>…" style="width:100%;margin-top:8px"></textarea>
    <div id="sv-out" style="margin-top:12px"></div>
    <div class="err" id="sv-err"></div>
  </div>

  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>

  <div class="panel" id="p-favicon">
    <h2>Favicon pack</h2>
    <p class="hint">Upload a square-ish image — get all standard favicon sizes as PNGs plus the manifest snippet, generated locally.</p>
    <input type="file" id="fav-file" accept="image/*" style="font-size:13px">
    <div id="fav-drop" style="margin:10px 0;padding:26px;border:2px dashed var(--border);border-radius:10px;text-align:center;color:var(--dim);font-size:13px">…or drag an image here</div>
    <div id="fav-out"></div>
    <div class="err" id="fav-err"></div>
  </div>


  <div class="panel" id="p-sitemapgen">
    <h2>sitemap.xml generator</h2>
    <p class="hint">One URL per line. Optional: <code>url, lastmod, priority</code> (comma-separated).</p>
    <textarea id="smg-in" placeholder="https://example.com/&#10;https://example.com/about, 2026-11-15, 0.8&#10;https://example.com/blog" style="width:100%;height:110px"></textarea>
    <div class="out" id="smg-out" style="white-space:pre;overflow-x:auto"></div>
    <button class="copy" id="smg-copy">copy xml</button>
    <div class="err" id="smg-err"></div>
  </div>


  <div class="panel" id="p-llmstxt">
    <h2>llms.txt generator</h2>
    <p class="hint">Generate an <a href="https://llmstxt.org/" target="_blank" rel="noopener">llms.txt</a> file so AI crawlers understand your site. One link per line: <code>title | url | note(optional)</code>.</p>
    <input id="lt-name" placeholder="site / project name" style="width:100%;padding:7px 10px;border-radius:8px;border:1px solid var(--border);background:var(--bg);color:var(--fg);margin-bottom:6px">
    <textarea id="lt-desc" placeholder="one-paragraph description of what the site is" style="width:100%;height:44px"></textarea>
    <textarea id="lt-links" placeholder="docs | https://example.com/docs | API reference&#10;blog | https://example.com/blog" style="width:100%;height:90px;margin-top:6px"></textarea>
    <div class="out" id="lt-out" style="white-space:pre;overflow-x:auto"></div>
    <button class="copy" id="lt-copy">copy llms.txt</button>
    <div class="err" id="lt-err"></div>
  </div>



<script is:inline src="/js/pages/tools/web.js"></script>
<footer>Free tools from <a href="../index.html">trendscope</a> · everything runs locally in your browser.</footer>

</Base>

<style is:global>
:root { --bg:#0d1117; --panel:#161b22; --border:#30363d; --fg:#e6edf3;
          --dim:#8b949e; --accent:#58a6ff; --green:#3fb950; }
  body { background: var(--bg); color: var(--fg);
         font: 14px/1.55 -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
         max-width: 900px; margin: 0 auto; padding: 28px 18px 60px; }
  a { color: var(--accent); text-decoration: none; } a:hover { text-decoration: underline; }
  nav a { color: var(--dim); font-size: 13px; }
  h1 { font-size: 26px; margin: 14px 0 4px; } h1 span { color: var(--accent); }
  .sub { color: var(--dim); margin-bottom: 20px; }
  .tabs { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 22px; }
  .tabs button {
    background: var(--panel); color: var(--dim); border: 1px solid var(--border);
    border-radius: 8px; padding: 7px 14px; font: inherit; font-size: 13px; cursor: pointer;
  }
  .tabs button.active { color: var(--fg); border-color: var(--accent); background: #1c2330; }
  .panel { display: none; background: var(--panel); border: 1px solid var(--border);
           border-radius: 10px; padding: 20px; }
  .panel.active { display: block; }
  h2 { font-size: 16px; margin-bottom: 4px; }
  .hint { color: var(--dim); font-size: 13px; margin-bottom: 14px; }
  label { display: block; font-size: 12px; color: var(--dim); margin: 12px 0 4px; }
  input[type=text], textarea, select {
    width: 100%; background: var(--bg); color: var(--fg); border: 1px solid var(--border);
    border-radius: 8px; padding: 9px 12px; font: inherit; font-family: ui-monospace, monospace;
  }
  .row { display: flex; gap: 12px; flex-wrap: wrap; }
  .row > div { flex: 1; min-width: 200px; }
  .out { font-family: ui-monospace, monospace; background: var(--bg); border: 1px solid var(--border);
         border-radius: 8px; padding: 10px 12px; margin-top: 10px; word-break: break-all; white-space: pre-wrap; }
  .err { color: #f85149; font-size: 13px; margin-top: 8px; }
  button.copy { background: var(--panel); color: var(--dim); border: 1px solid var(--border);
    border-radius: 6px; padding: 4px 12px; font: inherit; font-size: 12px; cursor: pointer; margin-top: 8px; }
  button.copy:hover { color: var(--fg); }
  footer { margin-top: 40px; padding-top: 16px; border-top: 1px solid var(--border); color: var(--dim); font-size: 12px; }
  .card { border: 1px solid var(--border); border-radius: 8px; overflow: hidden; margin-top: 10px; background: #fff; color: #1c1e21; }
  .card .img { background: #ced0d4; height: 110px; display: flex; align-items: center; justify-content: center; color: #65676b; font-size: 12px; }
  .card .txt { padding: 8px 10px; }
  .card .dom { color: #65676b; font-size: 11px; text-transform: uppercase; }
  .card .ttl { font-weight: 600; font-size: 14px; }
  .card .dsc { color: #65676b; font-size: 12px; }
  .chk { display: flex; align-items: center; gap: 8px; margin: 6px 0; font-size: 13px; cursor: pointer; }
</style>