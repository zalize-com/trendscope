---
import Base from "../layouts/Base.astro";
const title = "domains \u2014 trendscope";
const description = "Which domains developers keep sharing: most-linked sites across the trendscope daily snapshots.";
const path = '/domains.html';
---
<Base title={title} description={description} path={path} nav="none">

<nav><a href="index.html">← trendscope</a> · <a href="streaks.html">streaks</a> · <a href="compare.html">compare</a></nav>
  <h1>dom<span>ains</span></h1>
  <p class="sub">Most-linked sites across all daily snapshots — grouped by hostname from <code>data/history.csv</code> · <a href="docs/api/domains.json">↓ json</a></p>
  <div id="out"><p id="err">loading…</p></div>

<script is:inline src="/js/pages/domains.mjs" type="module"></script>

<footer>Open data, <a href="https://creativecommons.org/publicdomain/zero/1.0/">CC0</a> ·     <a href="https://github.com/zalize-com/trendscope">github.com/zalize-com/trendscope</a></footer>

</Base>

<style is:global>
@media (prefers-color-scheme: dark) {
  :root:not([data-theme]) { --bg:#0d1117; --panel:#161b22; --border:#30363d; --fg:#e6edf3;
          --dim:#8b949e; --accent:#58a6ff; --green:#3fb950; }
}
html[data-theme="dark"] { --bg:#0d1117; --panel:#161b22; --border:#30363d; --fg:#e6edf3;
          --dim:#8b949e; --accent:#58a6ff; --green:#3fb950; }
  body { background: var(--bg); color: var(--fg);
         font: 14px/1.55 -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
         max-width: 860px; margin: 0 auto; padding: 28px 18px 60px; }
  a { color: var(--accent); text-decoration: none; } a:hover { text-decoration: underline; }
  nav a { color: var(--dim); font-size: 13px; }
  h1 { font-size: 26px; margin: 14px 0 4px; } h1 span { color: var(--accent); }
  .sub { color: var(--dim); margin-bottom: 18px; }
  table { border-collapse: collapse; width: 100%; margin-top: 8px; }
  th { text-align: left; color: var(--dim); font-size: 11px; text-transform: uppercase;
       letter-spacing: .04em; padding: 6px 10px; border-bottom: 1px solid var(--border); }
  td { padding: 6px 10px; border-bottom: 1px solid var(--border); font-size: 13px; vertical-align: top; }
  .dom { font-family: ui-monospace, monospace; color: var(--fg); font-weight: 600; }
  .num { text-align: right; white-space: nowrap; font-family: ui-monospace, monospace; }
  .last { color: var(--dim); font-size: 12px; }
  .last a { color: var(--dim); }
  .srcs { color: var(--dim); font-size: 11px; }
  ol { padding: 0; margin: 8px 0; list-style: none; counter-reset: n; }
  li { counter-increment: n; display: flex; gap: 10px; padding: 6px 10px; border-bottom: 1px solid var(--border); font-size: 13px; align-items: baseline; }
  li::before { content: counter(n); color: var(--dim); font-family: ui-monospace, monospace; min-width: 1.6em; text-align: right; }
  .it { flex: 1; min-width: 0; }
  .sc { color: var(--dim); font-family: ui-monospace, monospace; font-size: 12px; white-space: nowrap; }
  footer { margin-top: 40px; padding-top: 16px; border-top: 1px solid var(--border); color: var(--dim); font-size: 12px; }
  #err { color: var(--dim); }

  /* a11y floor: focus ring + reduced motion (hallmark-style audit 2026-11-16) */
  :focus-visible { outline: 2px solid var(--accent, #58a6ff); outline-offset: 2px; }
</style>
