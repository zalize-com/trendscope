---
import Base from "../layouts/Base.astro";
const title = "trendscope embed \u2014 top of today's developer board";
const description = "";
const path = '/embed.html';
---
<Base title={title} description={description} path={path} nav="none">

<div class="brand">
    <b>trend<span>scope</span></b>
    <span class="date" id="date"></span>
  </div>
  <ol id="list"><li id="err">loading…</li></ol>
  <div class="foot"><a id="embedlink" href="#" style="margin-right:8px"><i data-lucide="copy"></i> embed</a><a href="https://trendscope.zalize.com/" target="_blank" rel="noopener">open dataset · CC0 →</a></div>
<script is:inline src="https://unpkg.com/lucide@latest"></script>

<script is:inline src="/js/pages/embed.js"></script>

</Base>

<style is:global>
:root {
    --bg: #0d1117; --panel: #161b22; --border: #30363d; --fg: #e6edf3;
    --dim: #8b949e; --accent: #58a6ff;
  }
  @media (prefers-color-scheme: light) {
  :root:not([data-theme]) { --bg: #f6f8fa; --panel: #ffffff; --border: #d0d7de; --fg: #1f2328;
      --dim: #59636e; --accent: #0969da; }
}
html[data-theme="light"] { --bg: #f6f8fa; --panel: #ffffff; --border: #d0d7de; --fg: #1f2328;
      --dim: #59636e; --accent: #0969da; }
  :root[data-theme="light"] {
    --bg: #f6f8fa; --panel: #ffffff; --border: #d0d7de; --fg: #1f2328;
    --dim: #59636e; --accent: #0969da;
  }
  body {
    background: var(--bg); color: var(--fg);
    font: 13px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
    padding: 10px 12px;
  }
  .brand { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 8px; }
  .brand b { font-size: 14px; }
  .brand b span { color: var(--accent); }
  .brand .date { color: var(--dim); font-size: 11px; }
  ol { list-style: none; }
  li {
    display: flex; gap: 8px; padding: 4px 0;
    border-bottom: 1px solid var(--border);
  }
  li:last-child { border-bottom: 0; }
  .rank { color: var(--dim); min-width: 14px; text-align: right; }
  a { color: var(--fg); text-decoration: none; }
  a:hover { color: var(--accent); text-decoration: underline; }
  .src {
    color: var(--dim); font-size: 10px; border: 1px solid var(--border);
    border-radius: 4px; padding: 0 4px; margin-left: 6px; white-space: nowrap;
  }
  .score { margin-left: auto; color: var(--dim); white-space: nowrap; font-size: 11px; }
  .score.up { color: var(--green, #3fb950); }
  .score.new { color: var(--accent); }
  .foot { margin-top: 8px; text-align: right; }
  .foot a { color: var(--dim); font-size: 11px; }
  #err { color: var(--dim); padding: 8px 0; }
svg.lucide{width:13px;height:13px;vertical-align:-2px}

  /* a11y floor: focus ring + reduced motion (hallmark-style audit 2026-11-16) */
  :focus-visible { outline: 2px solid var(--accent, #58a6ff); outline-offset: 2px; }
</style>
