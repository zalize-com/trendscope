---
import Base from "../layouts/Base.astro";
const title = "search \u2014 trendscope";
const description = "One search box over the whole dataset: 19 years of HN canon, Show HN and Ask HN monthly leaders, plus every item of the current multi-source daily snapshots.";
const path = '/search.html';
---
<Base title={title} description={description} path={path} nav="none">

<nav><a href="index.html">← trendscope</a> · <a href="canon.html">canon</a> · <a href="showhn.html">show&nbsp;hn</a> · <a href="rituals.html">rituals</a> · <a href="item.html">item history</a></nav>
  <h1>search the <span>dataset</span></h1>
  <p class="sub">One box over 19 years of HN canon, every monthly Show&nbsp;HN and Ask&nbsp;HN leader since 2007/2012, plus all 10+ days of the 15-source daily snapshots.</p>
  <input id="q" type="text" placeholder="search — e.g. bitcoin, layoffs, rust, 'who is hiring'" autofocus>
  <div class="corp" id="corp">
    <button data-c="all" class="on">all</button>
    <button data-c="canon">canon</button>
    <button data-c="showhn">show&nbsp;hn</button>
    <button data-c="askhn">ask&nbsp;hn</button>
    <button data-c="recent">recent&nbsp;snapshots</button>
  </div>
  <div id="meta">loading corpora…</div>
  <ol id="res"></ol>

</Base>

<style is:global>
@media (prefers-color-scheme:dark){:root{ --bg:#0d1117; --panel:#161b22; --border:#30363d; --fg:#e6edf3;
          --dim:#8b949e; --accent:#58a6ff; --green:#3fb950; --orange:#d29922; }}
  body { background: var(--bg); color: var(--fg);
         font: 14px/1.55 -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
         max-width: 900px; margin: 0 auto; padding: 28px 18px 60px; }
  a { color: var(--accent); text-decoration: none; } a:hover { text-decoration: underline; }
  nav a { color: var(--dim); font-size: 13px; }
  h1 { font-size: 26px; margin: 14px 0 4px; } h1 span { color: var(--accent); }
  .sub { color: var(--dim); margin-bottom: 14px; }
  input#q { width: 100%; padding: 12px 14px; border-radius: 10px; border: 1px solid var(--border);
            background: var(--panel); color: var(--fg); font-size: 16px; outline: none; }
  input#q:focus { border-color: var(--accent); }
  .corp { display: flex; gap: 8px; flex-wrap: wrap; margin: 12px 0 6px; }
  .corp button { border: 1px solid var(--border); border-radius: 999px; padding: 4px 12px;
                 background: none; color: var(--dim); font-size: 12px; cursor: pointer; }
  .corp button.on { color: var(--accent); border-color: var(--accent); }
  #meta { color: var(--dim); font-size: 12px; margin: 6px 0 12px; }
  ol { list-style: none; }
  li { display: flex; gap: 10px; padding: 6px 0; border-bottom: 1px solid var(--border); align-items: baseline; }
  .r { color: var(--dim); min-width: 20px; text-align: right; font-size: 12px; }
  .it a { color: var(--fg); } .it a:hover { color: var(--accent); }
  .it .yr { color: var(--dim); font-size: 11px; margin-left: 6px; }
  .tag { margin-left: 8px; font-size: 10px; color: var(--dim); border: 1px solid var(--border);
         border-radius: 4px; padding: 0 5px; white-space: nowrap; }
  .sc { margin-left: auto; white-space: nowrap; font-size: 12px; color: var(--dim); }
  .sc b { color: var(--orange); font-weight: 600; }
  mark { background: none; color: var(--orange); font-weight: 600; }
  footer { margin-top: 40px; padding-top: 16px; border-top: 1px solid var(--border); color: var(--dim); font-size: 12px; }

  /* a11y floor: focus ring + reduced motion (hallmark-style audit 2026-11-16) */
  :focus-visible { outline: 2px solid var(--accent, #58a6ff); outline-offset: 2px; }
</style>

<script is:inline src="/js/pages/search.mjs" type="module"></script>
