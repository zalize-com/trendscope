---
import Base from "../layouts/Base.astro";
const title = "rolling window \u2014 trendscope";
const description = "Top developer stories and packages over a rolling window (7/14/30 days) of the trendscope dataset.";
const path = '/week.html';
---
<Base title={title} description={description} path={path} nav="none">

<nav><a href="index.html">← trendscope</a> · <a href="streaks.html">streaks</a> · <a href="calendar.html">calendar</a> · <a href="digest.html">digests</a></nav>
  <h1 id="h1">this <span>week</span></h1>
  <div class="sub" id="wins"><a href="?d=7">7d</a> · <a href="?d=14">14d</a> · <a href="?d=30">30d</a> &nbsp;·&nbsp; <span id="wjson"></span></div>
  <div class="sub" id="sub">loading…</div>
  <div id="daystrip" style="display:flex;gap:5px;align-items:flex-end;margin:6px 0 2px"></div>
  <div id="out"><p id="err">loading…</p></div>

<script is:inline src="/js/pages/week.js"></script>

<footer>
    Computed in your browser from <a href="data/history.csv">history.csv</a> —
    sum of daily-normalized heat over the window. ·     <a href="https://github.com/zalize-com/trendscope">trendscope</a>
  </footer>

</Base>

<style is:global>
@media (prefers-color-scheme: dark) {
  :root:not([data-theme]) { --bg:#0d1117; --panel:#161b22; --border:#30363d; --fg:#e6edf3;
          --dim:#8b949e; --accent:#58a6ff; --green:#3fb950; --orange:#d29922; }
}
html[data-theme="dark"] { --bg:#0d1117; --panel:#161b22; --border:#30363d; --fg:#e6edf3;
          --dim:#8b949e; --accent:#58a6ff; --green:#3fb950; --orange:#d29922; }
  body { background: var(--bg); color: var(--fg);
         font: 14px/1.55 var(--font-sans)"Segoe UI", Helvetica, Arial, sans-serif;
         margin:0; padding: 28px 18px 60px; }
  body > :not(.topbar):not(.skiplink) { max-width: 860px; margin-left: auto; margin-right: auto; }
  a { color: var(--accent); text-decoration: none; } a:hover { text-decoration: underline; } body > nav a { color: var(--dim); font-size: 13px; }
  h1 { font-size: 26px; margin: 14px 0 4px; } h1 span { color: var(--accent); }
  .sub { color: var(--dim); margin-bottom: 18px; }
  h2 { font-size: 15px; color: var(--dim); font-weight: 600; margin: 26px 0 6px;
       text-transform: uppercase; letter-spacing: .04em; }
  ol { list-style: none; }
  li { display: flex; gap: 10px; padding: 5px 0; border-bottom: 1px solid var(--border); align-items: baseline; }
  .it a { color: var(--fg); } .it a:hover { color: var(--accent); }
  .src { color: var(--dim); font-size: 11px; border: 1px solid var(--border);
         border-radius: 4px; padding: 0 5px; margin-left: 6px; }
  .sc { margin-left: auto; white-space: nowrap; font-size: 12px; color: var(--dim); }
  .days { color: var(--green); font-weight: 600; }
  .db { display:inline-flex; flex-direction:column; align-items:center; gap:2px; }
  .db i { display:block; width:14px; background:var(--accent,#58a6ff); opacity:.65; border-radius:2px; }
  .db s { text-decoration:none; font-size:9px; color:var(--dim); }
  .src-chips { margin: 4px 0 10px; }
  .chip { display: inline-block; padding: 1px 9px; margin: 0 5px 5px 0; border: 1px solid var(--border);
          border-radius: 999px; color: var(--dim); font-size: 12px; cursor: pointer; }
  .chip.on { color: var(--accent); border-color: var(--accent); }
  footer { margin-top: 40px; padding-top: 16px; border-top: 1px solid var(--border); color: var(--dim); font-size: 12px; }
  #err { color: var(--dim); }

  /* a11y floor: focus ring + reduced motion (hallmark-style audit 2026-11-16) */
  :focus-visible { outline: 2px solid var(--accent, #58a6ff); outline-offset: 2px; }
</style>
