---
import Base from "../layouts/Base.astro";
const title = "calendar \u2014 trendscope";
const description = "A month of developer attention at a glance: each day's top item, computed from the trendscope daily snapshot history.";
const path = '/calendar.html';
---
<Base title={title} description={description} path={path} nav="none">

<nav><a href="index.html">← trendscope</a> · <a href="week.html">this week</a> · <a href="streaks.html">streaks</a></nav>
  <h1>attention <span>calendar</span></h1>
  <p class="sub" id="sub">Each day's highest-scoring item across all sources — from <code>data/history.csv</code>.</p>
  <div class="grid" id="grid"></div>

<script is:inline src="/js/pages/calendar.mjs" type="module"></script>

<footer>Open data, <a href="https://creativecommons.org/publicdomain/zero/1.0/">CC0</a> ·
    <a href="https://github.com/zalize-com/trendscope">github.com/zalize-com/trendscope</a></footer>

</Base>

<style is:global>
@media (prefers-color-scheme:dark){:root{ --bg:#0d1117; --panel:#161b22; --border:#30363d; --fg:#e6edf3;
          --dim:#8b949e; --accent:#58a6ff; --green:#3fb950; --orange:#d29922; }}
  body { background: var(--bg); color: var(--fg);
         font: 14px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
         max-width: 1060px; margin: 0 auto; padding: 28px 18px 60px; }
  a { color: var(--accent); text-decoration: none; } a:hover { text-decoration: underline; }
  nav a { color: var(--dim); font-size: 13px; }
  h1 { font-size: 26px; margin: 14px 0 4px; } h1 span { color: var(--accent); }
  .sub { color: var(--dim); margin-bottom: 18px; }
  .grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 8px; }
  .dow { color: var(--dim); font-size: 11px; text-transform: uppercase; text-align: center; padding: 4px 0; }
  .cell { background: var(--panel); border: 1px solid var(--border); border-radius: 8px;
          min-height: 108px; padding: 8px; font-size: 12px; overflow: hidden; }
  .cell.empty { background: transparent; border: none; }
  .cell .d { color: var(--dim); font-size: 11px; margin-bottom: 4px; }
  .cell.today { border-color: var(--accent); }
  .cell a { color: var(--fg); display: block; line-height: 1.35; }
  .cell a:hover { color: var(--accent); text-decoration: none; }
  .cell .meta { color: var(--dim); font-size: 10px; margin-top: 4px; }
  .cell .src { color: var(--dim); border: 1px solid var(--border); border-radius: 4px; padding: 0 4px; }
  .cell.none { opacity: .45; }
  footer { margin-top: 40px; padding-top: 16px; border-top: 1px solid var(--border); color: var(--dim); font-size: 12px; }

  /* a11y floor: focus ring + reduced motion (hallmark-style audit 2026-11-16) */
  :focus-visible { outline: 2px solid var(--accent, #58a6ff); outline-offset: 2px; }
</style>
