---
import Base from "../layouts/Base.astro";
const title = "hiring pulse \u2014 trendscope";
const description = "HN 'Who is hiring?' tracker \u2014 monthly thread comment counts archived daily. The labor-demand signal nobody else keeps.";
const path = '/hiring.html';
---
<Base title={title} description={description} path={path} nav="none">

<nav><a href="index.html">← trendscope</a> · <a href="ideas.html">ideas</a> · <a href="digest.html">digests</a></nav>
  <h1>hiring <span>pulse</span></h1>
  <p class="sub">HN's monthly <i>Who is hiring?</i> / <i>Who wants to be hired?</i> threads, snapshotted daily.
    Comment counts = how many companies are hiring vs how many people are looking.</p>
  <p class="muted" style="margin-top:2px"><a class="dlchip" href="data/hiring-monthly.csv" download>↓ hiring-monthly.csv</a></p>
  <div class="cards" id="cards"></div>
  <div id="hist"></div>
  <div id="daily"></div>
  <p class="note" id="note"></p>

<script is:inline src="/js/pages/hiring.js"></script>

<footer>Data: <a href="data/hiring.json">data/hiring.json</a> · <a href="docs/api/hiring-history.json">hiring-history.json</a> ·     <a href="https://github.com/zalize-com/trendscope">github.com/zalize-com/trendscope</a> · CC0</footer>

</Base>

<style is:global>
@media (prefers-color-scheme: dark) {
  :root:not([data-theme]) { --bg:#0d1117; --panel:#161b22; --border:#30363d; --fg:#e6edf3;
          --dim:#8b949e; --accent:#58a6ff; --green:#3fb950; --orange:#d29922; --red:#f85149; }
}
html[data-theme="dark"] { --bg:#0d1117; --panel:#161b22; --border:#30363d; --fg:#e6edf3;
          --dim:#8b949e; --accent:#58a6ff; --green:#3fb950; --orange:#d29922; --red:#f85149; }
  body { background: var(--bg); color: var(--fg);
         font: 14px/1.55 -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
         margin:0; padding: 28px 18px 60px; }
  body > :not(.topbar):not(.skiplink) { max-width: 860px; margin-left: auto; margin-right: auto; }
  a { color: var(--accent); text-decoration: none; } a:hover { text-decoration: underline; }
  nav a { color: var(--dim); font-size: 13px; }
  h1 { font-size: 26px; margin: 14px 0 4px; } h1 span { color: var(--accent); }
  .sub { color: var(--dim); margin-bottom: 18px; }
  .cards { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin: 14px 0; }
  @media (max-width: 620px) { .cards { grid-template-columns: 1fr; } }
  .card { background: var(--panel); border: 1px solid var(--border); border-radius: 10px; padding: 16px 18px; }
  .card h3 { font-size: 13px; color: var(--dim); font-weight: 600; margin-bottom: 8px; }
  .card .n { font-size: 34px; font-weight: 700; }
  .card.hire .n { color: var(--green); } .card.seek .n { color: var(--orange); }
  .card small { color: var(--dim); display: block; margin-top: 6px; font-size: 12px; }
  .card a { font-size: 13px; }
  h2 { font-size: 15px; color: var(--dim); font-weight: 600; margin: 26px 0 10px;
       text-transform: uppercase; letter-spacing: .04em; }
  .chart { width: 100%; background: var(--panel); border: 1px solid var(--border); border-radius: 10px; }
  .leg { display: flex; gap: 18px; font-size: 12px; color: var(--dim); margin-top: 8px; }
  .leg b { font-weight: 400; }
  .dot { display: inline-block; width: 10px; height: 10px; border-radius: 5px; margin-right: 5px; }
  .note { color: var(--dim); font-size: 13px; margin-top: 14px; }
  footer { margin-top: 40px; padding-top: 16px; border-top: 1px solid var(--border); color: var(--dim); font-size: 12px; }
  .dlchip{display:inline-block;padding:2px 8px;border:1px solid var(--bord,var(--border));border-radius:12px;font-size:12px;color:var(--fg,var(--fg));text-decoration:none;opacity:.8}
  .dlchip:hover{opacity:1;border-color:var(--accent,#58a6ff)}

  /* a11y floor: focus ring + reduced motion (hallmark-style audit 2026-11-16) */
  :focus-visible { outline: 2px solid var(--accent, #58a6ff); outline-offset: 2px; }
</style>
