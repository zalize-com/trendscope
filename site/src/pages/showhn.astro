---
import Base from "../layouts/Base.astro";
const title = "show hn canon \u2014 trendscope";
const description = "The Show HN canon: every month's top-10 product launches since 2012 \u2014 a ranked history of what builders shipped.";
const path = '/showhn.html';
---
<Base title={title} description={description} path={path} nav="none">

<nav><a href="index.html">← trendscope</a> · <a href="canon.html">canon</a> · <a href="rituals.html">rituals</a></nav>
  <h1>the <span>show hn</span> canon</h1>
  <p class="sub" id="sub">Every month's top-10 Show HN product launches, backfilled to January 2012 — the history of what builders shipped, month by month. <a href="docs/showhn-analysis.md">what it's made of →</a></p>
  <p class="muted" style="margin-top:2px"><a class="dlchip" href="data/show-hn-monthly.csv" download>↓ showhn-monthly.csv</a></p>
  <div class="stats" id="stats"></div>
  <h2>attention inflation — avg #1 score per year</h2>
  <div class="bars" id="infl"></div>
  <h2>this month in history</h2>
  <ol id="timh"></ol>
  <h2>browse a month</h2>
  <select id="mpick" style="background:var(--card);color:var(--fg);border:1px solid var(--line);border-radius:8px;padding:7px 10px;font-size:13px;margin-bottom:8px"></select>
  <ol id="browse"></ol>
  <h2>all-time top 40</h2>
  <div class="cn" id="years"></div>
  <ol id="out"></ol>

<script is:inline src="/js/pages/showhn.mjs" type="module"></script>

</Base>

<style is:global>
@media (prefers-color-scheme:dark){:root{ --bg:#0d1117; --panel:#161b22; --border:#30363d; --fg:#e6edf3;
          --dim:#8b949e; --accent:#58a6ff; --green:#3fb950; --orange:#d29922; }}
  body { background: var(--bg); color: var(--fg);
         font: 14px/1.55 -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
         max-width: 900px; margin: 0 auto; padding: 28px 18px 60px; }
  a { color: var(--accent); text-decoration: none; } a:hover { text-decoration: underline; }
  nav a { color: var(--dim); font-size: 13px; }
  h1 { font-size: 26px; margin: 14px 0 4px; } h1 span { color: var(--accent); }
  .sub { color: var(--dim); margin-bottom: 18px; }
  .stats { display: flex; gap: 22px; flex-wrap: wrap; margin: 10px 0 6px; }
  .stat b { font-size: 24px; } .stat small { color: var(--dim); display: block; font-size: 11px; }
  h2 { font-size: 15px; color: var(--dim); font-weight: 600; margin: 28px 0 8px;
       text-transform: uppercase; letter-spacing: .04em; }
  ol { list-style: none; }
  li { display: flex; gap: 10px; padding: 5px 0; border-bottom: 1px solid var(--border); align-items: baseline; }
  .r { color: var(--dim); min-width: 22px; text-align: right; }
  .trj { color: var(--dim); font-size: 11px; margin-left: 6px; text-decoration: none; }
  .trj:hover { color: var(--accent); }
  .it a { color: var(--fg); } .it a:hover { color: var(--accent); }
  .it .yr { color: var(--dim); font-size: 11px; margin-left: 6px; }
  .sc { margin-left: auto; white-space: nowrap; font-size: 12px; color: var(--dim); }
  .sc b { color: var(--orange); font-weight: 600; }
  .cn { display: flex; gap: 8px; flex-wrap: wrap; }
  .cn a { border: 1px solid var(--border); border-radius: 999px; padding: 3px 10px;
          font-size: 12px; color: var(--dim); }
  .cn a.on, .cn a:hover { color: var(--accent); border-color: var(--accent); text-decoration: none; }
  .bars { display: flex; align-items: flex-end; gap: 3px; height: 90px; margin-top: 6px; }
  .bcol { flex: 1; display: flex; flex-direction: column; justify-content: flex-end; align-items: center; gap: 3px; }
  .bcol .b { width: 100%; background: var(--accent); border-radius: 3px 3px 0 0; opacity: .75; }
  .bcol .y { color: var(--dim); font-size: 9px; }
  .bcol .v { color: var(--dim); font-size: 9px; }
  footer { margin-top: 40px; padding-top: 16px; border-top: 1px solid var(--border); color: var(--dim); font-size: 12px; }
  .dlchip{display:inline-block;padding:2px 8px;border:1px solid var(--bord,var(--border));border-radius:12px;font-size:12px;color:var(--fg,var(--fg));text-decoration:none;opacity:.8}
  .dlchip:hover{opacity:1;border-color:var(--accent,#58a6ff)}

  /* a11y floor: focus ring + reduced motion (hallmark-style audit 2026-11-16) */
  :focus-visible { outline: 2px solid var(--accent, #58a6ff); outline-offset: 2px; }
</style>
