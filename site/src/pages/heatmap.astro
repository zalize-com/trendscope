---
import Base from "../layouts/Base.astro";
const title = "weekday heatmap \u2014 trendscope";
const description = "Which days each source produces items \u2014 a source \u00d7 weekday intensity grid.";
const path = '/heatmap.html';
---
<Base title={title} description={description} path={path} nav="none">

<h1>weekday heatmap</h1>
<div class="sub">Which days each source produces items — per-row normalized, so every lane shows its own rhythm.</div>
<nav><a href="index.html">← board</a><a href="weekday.html">weekday</a><a href="rhythm.html">hourly rhythm</a><a href="sources.html">sources</a><a href="docs/api/weekday.json">↓ weekday.json</a></nav>
<div id="stats"></div>
<div id="out"></div>
<div id="err"></div>

<script is:inline src="/js/pages/heatmap.mjs" type="module"></script>

</Base>

<style is:global>
:root{--bg:#fff;--fg:#1f2328;--dim:#57606a;--line:#d8dee4;--acc:#0969da;--hot:#cf222e}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme]) { --bg:#0d1117;--fg:#e6edf3;--dim:#8b949e;--line:#30363d;--acc:#58a6ff;--hot:#f85149 }
}
html[data-theme="dark"] { --bg:#0d1117;--fg:#e6edf3;--dim:#8b949e;--line:#30363d;--acc:#58a6ff;--hot:#f85149 }
body{margin:0;padding:16px;background:var(--bg);color:var(--fg);font:14px/1.5 ui-monospace,SFMono-Regular,Menlo,monospace}
  body > :not(.topbar):not(.skiplink) { max-width: 900px; margin-left: auto; margin-right: auto; }
a{color:var(--acc);text-decoration:none}
h1{font-size:22px;margin:4px 0}
.sub{color:var(--dim);font-size:13px;margin-bottom:14px} body > nav{font-size:13px;margin:8px 0 14px} body > nav a{margin-right:8px}
table{border-collapse:collapse;width:100%;font-size:12px}
td,th{padding:3px 5px;border:1px solid var(--line);text-align:center}
th{background:var(--bg);font-weight:600;position:sticky;top:0}
td.src{text-align:left;white-space:nowrap}
.cell{display:inline-block;min-width:38px;padding:1px 0;border-radius:3px}
.legend{color:var(--dim);font-size:12px;margin:10px 0}
#err{color:var(--hot);margin-top:12px}
.stat{display:inline-block;border:1px solid var(--line);border-radius:6px;padding:2px 8px;margin:0 6px 6px 0;font-size:12px}

  /* a11y floor: focus ring + reduced motion (hallmark-style audit 2026-11-16) */
  :focus-visible { outline: 2px solid var(--accent, #58a6ff); outline-offset: 2px; }
</style>
