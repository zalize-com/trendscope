---
import Base from "../layouts/Base.astro";
const title = "trendscope topics \u2014 what developers are paying attention to";
const description = "Per-topic drill-down of the daily developer-attention snapshot: every HN story, trending repo and package download matching a topic. Open data, CC0.";
const path = '/topics.html';
---
<Base title={title} description={description} path={path} nav="topics">

<nav><a href="index.html">← trendscope</a> · <a href="data/latest.json">latest.json</a></nav>
  <h1 id="h1">topi<span>cs</span></h1>
  <p class="sub" id="sub">loading…</p>
  <div class="chips" id="chips"></div>
  <p class="sub" id="movers" style="margin:-6px 0 12px"></p>
  <div id="out"><p id="err"></p></div>

<script is:inline src="/js/pages/topics.js"></script>

<footer>
    Open data, <a href="https://creativecommons.org/publicdomain/zero/1.0/">CC0</a> ·     <a href="https://github.com/zalize-com/trendscope">github.com/zalize-com/trendscope</a> ·
    updated daily
  </footer>

</Base>

<style is:global>
:root {
    --bg: #0d1117; --panel: #161b22; --border: #30363d; --fg: #e6edf3;
    --dim: #8b949e; --accent: #58a6ff;
  }
  body {
    background: var(--bg); color: var(--fg);
    font: 14px/1.55 -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
    margin:0; padding: 28px 18px 60px;
  }
  body > :not(.topbar):not(.skiplink) { max-width: 860px; margin-left: auto; margin-right: auto; }
  a { color: var(--accent); text-decoration: none; }
  a:hover { text-decoration: underline; } body > nav a { color: var(--dim); font-size: 13px; }
  h1 { font-size: 26px; margin: 14px 0 4px; }
  h1 span { color: var(--accent); }
  .sub { color: var(--dim); margin-bottom: 18px; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; margin: 14px 0 26px; }
  .chip {
    border: 1px solid var(--border); border-radius: 14px; padding: 3px 12px;
    color: var(--dim); font-size: 12px;
  }
  .chip b { color: var(--fg); }
  .chip.on { border-color: var(--accent); color: var(--fg); }
  h2 { font-size: 15px; color: var(--dim); font-weight: 600; margin: 22px 0 6px;
       text-transform: uppercase; letter-spacing: .04em; }
  ol { list-style: none; }
  li { display: flex; gap: 10px; padding: 5px 0; border-bottom: 1px solid var(--border); }
  li:last-child { border-bottom: 0; }
  .r { color: var(--dim); min-width: 18px; text-align: right; }
  .trj { color: var(--dim); font-size: 11px; margin-left: 6px; text-decoration: none; }
  .trj:hover { color: var(--accent); }
  .it a { color: var(--fg); }
  .it a:hover { color: var(--accent); }
  .sc { margin-left: auto; color: var(--dim); font-size: 12px; white-space: nowrap; }
  footer { margin-top: 40px; padding-top: 16px; border-top: 1px solid var(--border); color: var(--dim); font-size: 12px; }
  #err { color: var(--dim); }

  /* a11y floor: focus ring + reduced motion (hallmark-style audit 2026-11-16) */
  :focus-visible { outline: 2px solid var(--accent, #58a6ff); outline-offset: 2px; }
</style>
