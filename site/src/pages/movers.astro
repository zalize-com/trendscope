---
import Base from "../layouts/Base.astro";
const title = "movers \u2014 trendscope";
const description = "What entered, left, climbed and dropped between the last two trendscope daily snapshots \u2014 the board's daily diff.";
const path = '/movers.html';
---
<Base title={title} description={description} path={path} nav="movers">

<nav><a href="index.html">← trendscope</a> · <a href="compare.html">compare</a> · <a href="risers.html">risers</a></nav>
  <h1>m<span>overs</span></h1>
  <p class="sub">What changed between daily snapshots — entered, left, climbed and dropped, plus package rank shifts.
    <a href="docs/api/movers-latest.json">↓ json</a> · <a href="docs/movers/">md archive</a></p>
  <p style="font-size:12px;color:var(--dim)">snapshot pair: <select id="dpick"></select></p>
  <div class="stats" id="stats"></div>
  <div id="out"><p id="err">loading…</p></div>

<script is:inline src="/js/pages/movers.mjs" type="module"></script>

<footer>Open data, <a href="https://creativecommons.org/publicdomain/zero/1.0/">CC0</a> ·     <a href="https://github.com/zalize-com/trendscope">github.com/zalize-com/trendscope</a></footer>

</Base>

<style is:global>
@media (prefers-color-scheme: dark) {
  :root:not([data-theme]) { --bg:#0d1117; --panel:#161b22; --border:#30363d; --fg:#e6edf3;
          --dim:#8b949e; --accent:#58a6ff; --green:#3fb950; --red:#f85149; --orange:#d29922; }
}
html[data-theme="dark"] { --bg:#0d1117; --panel:#161b22; --border:#30363d; --fg:#e6edf3;
          --dim:#8b949e; --accent:#58a6ff; --green:#3fb950; --red:#f85149; --orange:#d29922; }
  body { background: var(--bg); color: var(--fg);
         font: 14px/1.55 -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
         max-width: 860px; margin: 0 auto; padding: 28px 18px 60px; }
  a { color: var(--accent); text-decoration: none; } a:hover { text-decoration: underline; }
  nav a { color: var(--dim); font-size: 13px; }
  h1 { font-size: 26px; margin: 14px 0 4px; } h1 span { color: var(--accent); }
  .sub { color: var(--dim); margin-bottom: 18px; }
  .stats { display: flex; gap: 18px; flex-wrap: wrap; margin: 10px 0 6px; }
  .stat b { font-size: 22px; } .stat small { color: var(--dim); display: block; font-size: 11px; }
  h2 { font-size: 15px; color: var(--dim); font-weight: 600; margin: 26px 0 6px;
       text-transform: uppercase; letter-spacing: .04em; }
  ol { list-style: none; }
  li { display: flex; gap: 10px; padding: 5px 0; border-bottom: 1px solid var(--border); align-items: baseline; }
  .it a { color: var(--fg); } .it a:hover { color: var(--accent); }
  .src { color: var(--dim); font-size: 11px; border: 1px solid var(--border);
         border-radius: 4px; padding: 0 5px; margin-left: 6px; }
  .sc { margin-left: auto; white-space: nowrap; font-size: 12px; color: var(--dim); }
  .up { color: var(--green); font-weight: 600; } .down { color: var(--red); font-weight: 600; }
  .trj { color: var(--dim); font-size: 11px; margin-left: 6px; text-decoration: none; }
  .trj:hover { color: var(--accent); }
  select { background: var(--panel); color: var(--fg); border: 1px solid var(--border);
           border-radius: 6px; padding: 3px 8px; font: inherit; }
  footer { margin-top: 40px; padding-top: 16px; border-top: 1px solid var(--border); color: var(--dim); font-size: 12px; }
  #err { color: var(--dim); }

  /* a11y floor: focus ring + reduced motion (hallmark-style audit 2026-11-16) */
  :focus-visible { outline: 2px solid var(--accent, #58a6ff); outline-offset: 2px; }
</style>
