---
import Base from "../layouts/Base.astro";
const title = "new today \u2014 trendscope";
const description = "Items on today\u2019s boards that have never appeared in the trendscope history before \u2014 true first-seen entries.";
const path = '/new.html';
---
<Base title={title} description={description} path={path} nav="none">

<nav><a href="index.html">← trendscope</a> · <a href="risers.html">risers</a> · <a href="movers.html">movers</a> · <a href="week.html">this week</a></nav>
  <h1 id="h1">new <span>today</span></h1>
  <div class="sub" id="sub">loading…</div>
  <div class="sub" style="margin-top:-12px"><a href="docs/api/new.json">↓ new.json</a> · <a href="api.html">api</a></div>
  <div id="daystrip"></div>
  <h2>first seen today</h2>
  <ol id="out"><li id="err">loading…</li></ol>

<script is:inline src="/js/pages/new.js"></script>

</Base>

<style is:global>
@media (prefers-color-scheme:dark){:root{ --bg:#0d1117; --panel:#161b22; --border:#30363d; --fg:#e6edf3;
          --dim:#8b949e; --accent:#58a6ff; --green:#3fb950; --orange:#d29922; }}
  body { background: var(--bg); color: var(--fg);
         font: 14px/1.55 -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
         max-width: 860px; margin: 0 auto; padding: 28px 18px 60px; }
  a { color: var(--accent); text-decoration: none; } a:hover { text-decoration: underline; }
  nav a { color: var(--dim); font-size: 13px; }
  h1 { font-size: 26px; margin: 14px 0 4px; } h1 span { color: var(--accent); }
  .sub { color: var(--dim); margin-bottom: 18px; }
  h2 { font-size: 15px; color: var(--dim); font-weight: 600; margin: 26px 0 6px;
       text-transform: uppercase; letter-spacing: .04em; }
  table { border-collapse: collapse; width: 100%; font-size: 12px; }
  td, th { border: 1px solid var(--border); padding: 3px 4px; text-align: center; }
  th { color: var(--dim); font-weight: 600; }
  td.src { color: var(--dim); text-align: left; padding-left: 8px; white-space: nowrap; }
  td.c { color: var(--fg); }
  footer { margin-top: 40px; padding-top: 16px; border-top: 1px solid var(--border); color: var(--dim); font-size: 12px; }
  #err { color: var(--dim); }

  /* a11y floor: focus ring + reduced motion (hallmark-style audit 2026-11-16) */
  :focus-visible { outline: 2px solid var(--accent, #58a6ff); outline-offset: 2px; }
</style>
