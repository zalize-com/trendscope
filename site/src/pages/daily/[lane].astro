---
import Base from "../../layouts/Base.astro";

export function getStaticPaths() {
  const lanes = ["sec", "eb", "tb", "br", "nl", "pb", "yt", "tldr", "misc"];
  return lanes.map((lane) => ({ params: { lane } }));
}

const LANES = {
  sec:  { name: "security news",        what: "security research, CVEs, advisories and threat intel",              n: 130 },
  eb:   { name: "engineering blogs",    what: "posts from company engineering blogs",                              n: 86 },
  tb:   { name: "tech blogs",           what: "mainstream tech publications and news sites",                       n: 186 },
  br:   { name: "developer blogs",      what: "personal developer blogs and essays",                               n: 6088 },
  nl:   { name: "newsletters",          what: "curated tech newsletters",                                          n: 136 },
  pb:   { name: "tech podcasts",        what: "podcast episodes across the dev ecosystem",                         n: 98 },
  yt:   { name: "tech videos",          what: "YouTube channels for developers",                                   n: 44 },
  tldr: { name: "TLDR digests",         what: "TLDR newsletter sections",                                          n: 13 },
  misc: { name: "tech links",           what: "aggregators, subreddits and unlaned feeds",                         n: 2416 },
};

const { lane } = Astro.params;
const L = LANES[lane];
const title = `Daily ${L.name} — trendscope`;
const description = `Today's ${L.name}: the freshest ${L.what}, snapshotted daily from ${L.n.toLocaleString("en-US")} tracked sources. Open data (CC0), updated by automation.`;
const path = `/daily/${lane}.html`;
const jsonld = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": title,
  "description": description,
  "isPartOf": { "@type": "WebSite", "name": "trendscope" },
};
---
<Base title={title} description={description} path={path} nav="none" jsonld={jsonld}>

<nav><a href="../index.html">← trendscope</a> · <a href="index.html">all lanes</a> · <a href="../digest.html">weekly digest</a> · <a href="../feeds.html">feed directory</a></nav>
  <h1>Daily <span>{L.name}</span></h1>
  <p class="sub">The freshest {L.what}, snapshotted daily from {L.n.toLocaleString("en-US")} tracked sources —
    part of the <a href="https://trendscope.zalize.com" style="font-weight:600">trendscope</a> open dataset (CC0).</p>
  <div id="daily" data-lane={lane}><p id="err">loading…</p></div>

<script is:inline src="/js/pages/daily.mjs" type="module"></script>

<footer>Open data, <a href="https://creativecommons.org/publicdomain/zero/1.0/">CC0</a> ·
    <a href="https://github.com/zalize-com/trendscope">github.com/zalize-com/trendscope</a></footer>

</Base>

<style is:global>
  #daily .row { display:grid; grid-template-columns:34px 1fr auto; gap:8px; padding:7px 0;
    border-bottom:1px solid var(--border); align-items:baseline; }
  #daily .rank { color:var(--dim); font-variant-numeric:tabular-nums; font-size:12px; }
  #daily .meta { color:var(--dim); font-size:11px; white-space:nowrap; }
  #daily .score { color:var(--orange); font-weight:600; font-size:12px; }
  #daily .stamp { color:var(--dim); font-size:12px; margin-bottom:10px; }
</style>
