---
import Base from "../../layouts/Base.astro";
const title = "Daily digests by lane — trendscope";
const description = "Fresh daily digests per topic lane: security news, engineering blogs, developer blogs, newsletters, podcasts, tech videos and more — snapshotted daily from 9,200+ tracked sources.";
const path = "/daily/";
const jsonld = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "trendscope daily digests by lane",
  "description": description,
  "isPartOf": { "@type": "WebSite", "name": "trendscope" },
};
const lanes = [
  ["sec", "security news", "CVEs, advisories, threat intel"],
  ["eb", "engineering blogs", "company engineering blogs"],
  ["tb", "tech blogs", "mainstream tech publications"],
  ["br", "developer blogs", "personal dev blogs & essays"],
  ["nl", "newsletters", "curated tech newsletters"],
  ["pb", "tech podcasts", "podcast episodes"],
  ["yt", "tech videos", "developer YouTube channels"],
  ["tldr", "TLDR digests", "TLDR newsletter sections"],
  ["misc", "tech links", "aggregators, subreddits & more"],
];
---
<Base title={title} description={description} path={path} nav="none" jsonld={jsonld}>

<nav><a href="../index.html">← trendscope</a> · <a href="../digest.html">weekly digest</a> · <a href="../feeds.html">feed directory</a> · <a href="../selfhosted.html">self-hosted</a></nav>
  <h1>Daily <span>digests</span></h1>
  <p class="sub">Fresh snapshots per topic lane — updated daily by automation. Every item links back to its source.</p>
  <div class="lanes">
    {lanes.map(([lane, name, what]) => (
      <a class="card" href={`${lane}.html`}>
        <b>Daily {name}</b>
        <small>{what}</small>
      </a>
    ))}
  </div>

<footer>Open data, <a href="https://creativecommons.org/publicdomain/zero/1.0/">CC0</a> ·
    <a href="https://github.com/zalize-com/trendscope">github.com/zalize-com/trendscope</a></footer>

</Base>

<style is:global>
  body { padding: 28px 18px 60px; margin: 0; }
  body > :not(.topbar):not(.skiplink) { max-width: 960px; margin-left: auto; margin-right: auto; }
  .lanes { display:grid; grid-template-columns:repeat(auto-fill,minmax(240px,1fr)); gap:10px; margin-top:16px; }
  .card { display:block; border:1px solid var(--border); border-radius:8px; padding:12px 14px; color:var(--fg); }
  .card:hover { border-color:var(--accent); text-decoration:none; }
  .card b { display:block; font-size:15px; }
  .card small { color:var(--dim); }
</style>
