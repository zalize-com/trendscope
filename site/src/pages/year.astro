---
import Base from "../layouts/Base.astro";
const title = "a year of hn \u2014 trendscope";
const description = "Any year's Hacker News at a glance: each month's #1 story, #1 Show HN launch and #1 Ask HN question \u2014 2007 to today.";
const path = '/year.html';
---
<Base title={title} description={description} path={path} nav="none">

<nav><a href="index.html">← trendscope</a> · <a href="canon.html">canon</a> · <a href="showhn.html">show&nbsp;hn</a> · <a href="docs/askhn-analysis.md">analysis</a></nav>
  <h1>a <span>year</span> of hn</h1>
  <p class="sub">Pick a year — every month's #1 <b>story</b>, #1 <b>launch</b> and #1 <b>question</b>, on one page.</p>
  <p class="muted" style="margin-top:2px"><a class="dlchip" href="data/hn-canon-monthly.csv" download>↓ canon</a></p>
  <div class="stats" id="stats"></div>
  <select id="mpick"></select>
  <div class="cols">
    <div class="col story"><h2>📰 top stories</h2><ol id="story"></ol></div>
    <div class="col launch"><h2>🚀 top launches (Show HN)</h2><ol id="launch"></ol></div>
    <div class="col ask"><h2>❓ top questions (Ask HN)</h2><ol id="ask"></ol></div>
  </div>

<script is:inline src="/js/pages/year.mjs" type="module"></script>

</Base>

<style is:global>
:root { --bg:#0d1117; --fg:#e6edf3; --dim:#8b98a5; --card:#161b22; --line:#30363d;
          --accent:#58a6ff; --orange:#f0883e; --green:#3fb950; }
  @media (prefers-color-scheme: light) {
    :root { --bg:#fff; --fg:#1f2328; --dim:#57606a; --card:#f6f8fa; --line:#d0d7de; } }
  body { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
         background: var(--bg); color: var(--fg); margin: 0 auto; max-width: 1150px;
         padding: 24px 18px 64px; font-size: 14px; line-height: 1.55; }
  a { color: var(--accent); text-decoration: none; } a:hover { text-decoration: underline; }
  nav, footer { color: var(--dim); font-size: 12px; } footer { margin-top: 48px; }
  h1 { font-size: 22px; margin: 12px 0 2px; } h1 span { color: var(--orange); }
  .sub { color: var(--dim); font-size: 13px; margin: 0 0 18px; }
  select { background: var(--card); color: var(--fg); border: 1px solid var(--line);
           border-radius: 8px; padding: 7px 10px; font-size: 13px; }
  .cols { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px; margin-top: 16px; }
  @media (max-width: 900px) { .cols { grid-template-columns: 1fr; } }
  .col { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 12px 14px; }
  .col h2 { font-size: 13px; margin: 0 0 8px; font-weight: 600; }
  .col.story h2 { color: var(--accent); } .col.launch h2 { color: var(--orange); } .col.ask h2 { color: var(--green); }
  ol { margin: 0; padding: 0; list-style: none; }
  li { display: flex; gap: 8px; padding: 6px 0; border-top: 1px solid var(--line); }
  li:first-child { border-top: none; }
  .r { color: var(--dim); min-width: 18px; text-align: right; }
  .it { flex: 1; } .it a { font-size: 13px; } .trj { color: var(--dim); font-size: 11px; margin-left: 6px; text-decoration: none; } .trj:hover { color: var(--accent); }
  .sc { color: var(--dim); font-size: 11px; white-space: nowrap; }
  .stats { display: flex; gap: 12px; flex-wrap: wrap; margin: 14px 0 4px; }
  .stat { background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: 10px 14px; }
  .stat b { font-size: 19px; display: block; } .stat small { color: var(--dim); }
  .dlchip{display:inline-block;padding:2px 8px;border:1px solid var(--bord,#30363d);border-radius:12px;font-size:12px;color:var(--fg,#e6edf3);text-decoration:none;opacity:.8}
  .dlchip:hover{opacity:1;border-color:var(--accent,#58a6ff)}

  /* a11y floor: focus ring + reduced motion (hallmark-style audit 2026-11-16) */
  :focus-visible { outline: 2px solid var(--accent, #58a6ff); outline-offset: 2px; }
</style>
