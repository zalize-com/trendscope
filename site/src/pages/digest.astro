---
import Base from "../layouts/Base.astro";
const title = "digests \u2014 trendscope";
const description = "Weekly digests and daily movers generated from the trendscope developer attention dataset.";
const path = '/digest.html';
---
<Base title={title} description={description} path={path} nav="digests">

<nav><a href="index.html">← trendscope</a> · <a href="compare.html">compare</a> · <a href="topics.html">topics</a></nav>
  <h1>dig<span>ests</span></h1>
  <p class="sub">Auto-generated weekly digests from the dataset.</p>
  <div class="files" id="files"></div>
  <div id="doc"><p id="err">loading…</p></div>
  <p class="movers-note" id="movers"></p>
  <p class="movers-note" id="analysis"></p>

<script is:inline src="/js/pages/digest.mjs" type="module"></script>

<footer>Open data, <a href="https://creativecommons.org/publicdomain/zero/1.0/">CC0</a> ·     <a href="https://github.com/zalize-com/trendscope">github.com/zalize-com/trendscope</a> ·
    digest markdown lives in <a href="https://github.com/zalize-com/trendscope/tree/main/docs/digest">docs/digest</a></footer>

</Base>

<style is:global>
@media (prefers-color-scheme:dark){:root{ --bg:#0d1117; --panel:#161b22; --border:#30363d; --fg:#e6edf3;
          --dim:#8b949e; --accent:#58a6ff; --green:#3fb950; }}
  body { background: var(--bg); color: var(--fg);
         font: 14px/1.6 -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
         max-width: 860px; margin: 0 auto; padding: 28px 18px 60px; }
  a { color: var(--accent); text-decoration: none; } a:hover { text-decoration: underline; }
  nav a { color: var(--dim); font-size: 13px; }
  h1 { font-size: 26px; margin: 14px 0 4px; } h1 span { color: var(--accent); }
  .sub { color: var(--dim); margin-bottom: 18px; }
  .files { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 22px; }
  .files button {
    background: var(--panel); color: var(--dim); border: 1px solid var(--border);
    border-radius: 6px; padding: 5px 12px; font: inherit; font-size: 13px; cursor: pointer;
  }
  .files button.active { color: var(--fg); border-color: var(--accent); }
  .files button:hover { color: var(--fg); }
  #doc { background: var(--panel); border: 1px solid var(--border); border-radius: 10px; padding: 24px 28px; }
  #doc h1 { font-size: 22px; margin: 18px 0 8px; } #doc h2 { font-size: 17px; margin: 20px 0 8px; }
  #doc h3 { font-size: 15px; margin: 16px 0 6px; }
  #doc p { margin: 8px 0; } #doc ul, #doc ol { padding-left: 22px; margin: 8px 0; }
  #doc li { margin: 3px 0; }
  #doc code { background: rgba(110,118,129,.25); border-radius: 4px; padding: 1px 5px; font-size: 13px; }
  #doc pre { background: var(--bg); border: 1px solid var(--border); border-radius: 8px; padding: 12px; overflow-x: auto; margin: 10px 0; }
  #doc pre code { background: none; padding: 0; }
  #doc blockquote { border-left: 3px solid var(--border); padding-left: 12px; color: var(--dim); margin: 10px 0; }
  #doc table { border-collapse: collapse; margin: 10px 0; width: 100%; }
  #doc td, #doc th { border: 1px solid var(--border); padding: 5px 10px; font-size: 13px; }
  #doc hr { border: none; border-top: 1px solid var(--border); margin: 18px 0; }
  .movers-note { color: var(--dim); font-size: 13px; margin-top: 26px; }
  footer { margin-top: 40px; padding-top: 16px; border-top: 1px solid var(--border); color: var(--dim); font-size: 12px; }
  #err { color: var(--dim); }

  /* a11y floor: focus ring + reduced motion (hallmark-style audit 2026-11-16) */
  :focus-visible { outline: 2px solid var(--accent, #58a6ff); outline-offset: 2px; }
</style>
