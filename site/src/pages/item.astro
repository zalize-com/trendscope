---
import Base from "../layouts/Base.astro";
const title = "item history \u2014 trendscope";
const description = "Track a single story or package's rank and score across every day it's been on the trendscope board.";
const path = '/item.html';
---
<Base title={title} description={description} path={path} nav="none">

<nav><a href="index.html">← trendscope</a> · <a href="week.html">this week</a> · <a href="streaks.html">streaks</a></nav>
  <h1>item <span>history</span></h1>
  <div class="sub">Every day a story or package has been on the board — rank and score trajectory, from <a href="data/history.csv">history.csv</a>.</div>
  <input type="search" id="q" placeholder="search title / url / author — e.g. SpaceX, boto3, val.town…" autofocus>
  <div id="out"></div>

<script is:inline src="/js/pages/item.js"></script>

<footer>
    <a href="https://github.com/zalize-com/trendscope">trendscope</a> · CC0
  </footer>

</Base>

<style is:global>
@media (prefers-color-scheme: dark) {
  :root:not([data-theme]) { --bg:#0d1117; --panel:#161b22; --border:#30363d; --fg:#e6edf3;
          --dim:#8b949e; --accent:#58a6ff; --green:#3fb950; --orange:#d29922; }
}
html[data-theme="dark"] { --bg:#0d1117; --panel:#161b22; --border:#30363d; --fg:#e6edf3;
          --dim:#8b949e; --accent:#58a6ff; --green:#3fb950; --orange:#d29922; }
  body { background: var(--bg); color: var(--fg);
         font: 14px/1.55 var(--font-sans)"Segoe UI", Helvetica, Arial, sans-serif;
         margin:0; padding: 28px 18px 60px; }
  body > :not(.topbar):not(.skiplink) { max-width: 860px; margin-left: auto; margin-right: auto; }
  a { color: var(--accent); text-decoration: none; } a:hover { text-decoration: underline; } body > nav a { color: var(--dim); font-size: 13px; }
  h1 { font-size: 26px; margin: 14px 0 4px; } h1 span { color: var(--accent); }
  .sub { color: var(--dim); margin-bottom: 18px; }
  input[type=search] {
    width: 100%; padding: 8px 12px; background: var(--panel); color: var(--fg);
    border: 1px solid var(--border); border-radius: 6px; font-size: 14px;
  }
  h2 { font-size: 15px; color: var(--dim); font-weight: 600; margin: 22px 0 6px;
       text-transform: uppercase; letter-spacing: .04em; }
  ol { list-style: none; }
  li { display: flex; gap: 10px; padding: 5px 0; border-bottom: 1px solid var(--border); align-items: baseline; }
  .it a { color: var(--fg); } .it a:hover { color: var(--accent); }
  .src { color: var(--dim); font-size: 11px; border: 1px solid var(--border);
         border-radius: 4px; padding: 0 5px; margin-left: 6px; }
  .sc { margin-left: auto; white-space: nowrap; font-size: 12px; color: var(--dim); }
  .rk { color: var(--accent); font-weight: 600; min-width: 38px; text-align: right; }
  .card { background: var(--panel); border: 1px solid var(--border); border-radius: 8px; padding: 14px 16px; margin-top: 16px; }
  .card b { font-size: 16px; }
  .embed-btn { float: right; font: 11px ui-monospace, monospace; color: var(--dim);
    border: 1px solid var(--border); border-radius: 4px; padding: 2px 8px;
    background: none; cursor: pointer; }
  .embed-btn:hover { color: var(--fg); border-color: var(--dim); }
  .stats { display: flex; gap: 18px; flex-wrap: wrap; margin: 10px 0 0; }
  .stat b { font-size: 20px; } .stat small { color: var(--dim); display: block; font-size: 11px; }
  footer { margin-top: 40px; padding-top: 16px; border-top: 1px solid var(--border); color: var(--dim); font-size: 12px; }
  #err { color: var(--dim); }

  /* a11y floor: focus ring + reduced motion (hallmark-style audit 2026-11-16) */
  :focus-visible { outline: 2px solid var(--accent, #58a6ff); outline-offset: 2px; }
</style>
