---
import Base from "../layouts/Base.astro";
const title = "badges \u2014 trendscope";
const description = "Live data badges powered by trendscope's shields.io endpoint JSON \u2014 drop them into any README, no code required.";
const path = '/badges.html';
---
<Base title={title} description={description} path={path} nav="none">

<nav><a href="index.html">← trendscope</a> · <a href="embed.html">embeds</a> · <a href="docs/api.md">api</a> · <a href="datasets.html">datasets</a></nav>
  <h1>badges</h1>
  <p class="sub">Live <a href="https://shields.io/endpoint">shields.io endpoint badges</a> backed by this dataset —
    they refresh daily with the pipeline, no code required on your side. Paste the markdown into any README.</p>
  <div id="out"></div>
  <h2>make your own</h2>
  <p class="sub" style="margin-bottom:8px">Every endpoint in <a href="docs/api.md">docs/api.md</a> can feed a badge.
    Schema: <code>&#123;"schemaVersion":1,"label":"…","message":"…","color":"2b6cb0"&#125;</code>. See
    <code>scripts/stats.py</code> / <code>scripts/sources.py</code> for how ours are generated.</p>

<script is:inline src="/js/pages/badges.mjs" type="module"></script>

<footer>Open data, <a href="https://creativecommons.org/publicdomain/zero/1.0/">CC0</a> ·     <a href="https://github.com/zalize-com/trendscope">github.com/zalize-com/trendscope</a></footer>

</Base>

<style is:global>
@media (prefers-color-scheme:dark){:root{ --bg:#0d1117; --panel:#161b22; --border:#30363d; --fg:#e6edf3;
          --dim:#8b949e; --accent:#58a6ff; --green:#3fb950; --orange:#f0883e; }}
  body { background: var(--bg); color: var(--fg);
         font: 14px/1.55 -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
         max-width: 860px; margin: 0 auto; padding: 28px 18px 60px; }
  a { color: var(--accent); text-decoration: none; } a:hover { text-decoration: underline; }
  nav a { color: var(--dim); font-size: 13px; }
  h1 { font-size: 26px; margin: 14px 0 4px; } h1 span { color: var(--green); }
  .sub { color: var(--dim); margin-bottom: 18px; }
  h2 { font-size: 15px; margin: 22px 0 8px; color: var(--dim); text-transform: uppercase; letter-spacing:.05em; }
  .card { border:1px solid var(--border); border-radius:10px; padding:14px 16px; margin:10px 0 18px; background:var(--panel); }
  .card h3 { font-size:15px; margin-bottom:8px; }
  .card img { height:20px; vertical-align:middle; margin:4px 0 10px; }
  pre { background:var(--bg); border:1px solid var(--border); border-radius:8px; padding:10px 12px;
        font:12px/1.5 ui-monospace,monospace; overflow-x:auto; color:var(--fg); margin:6px 0; }
  .lbl { color:var(--dim); font-size:12px; margin-top:8px; }
  code { font-family:ui-monospace,monospace; font-size:12px; }
  footer { margin-top: 40px; padding-top: 16px; border-top: 1px solid var(--border); color: var(--dim); font-size: 12px; }

  /* a11y floor: focus ring + reduced motion (hallmark-style audit 2026-11-16) */
  :focus-visible { outline: 2px solid var(--accent, #58a6ff); outline-offset: 2px; }
</style>
