---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** path like "/movers.html" — used for canonical + og:url */
  path?: string;
  /** topbar active nav key: board|movers|topics|digests|tools|about|none */
  nav?: string;
  /** og:title override (defaults to title) */
  ogTitle?: string;
  ogDescription?: string;
  keywords?: string;
  /** extra JSON-LD objects to embed */
  jsonld?: object | object[];
  /** hide the topbar (embed.html etc.) */
  bare?: boolean;
  /** skip-to target id for the skiplink (default "#board") */
  skipTo?: string;
}

const {
  title,
  description = 'trendscope is a daily open dataset of developer attention — snapshotted every day, free to download (CC0).',
  path = '/',
  nav = 'none',
  ogTitle,
  ogDescription,
  keywords,
  jsonld,
  bare = false,
  skipTo = '#board',
} = Astro.props;

// Site origin: override with SITE_ORIGIN env var at build time
// (Pages flip: SITE_ORIGIN=https://zalize-com.github.io/trendscope npm run build).
// ORIGIN may carry a subpath (project Pages); keep it in canonical/og URLs.
const ORIGIN = (import.meta.env.SITE_ORIGIN
  ?? 'https://trendscope.zalize.com').replace(/\/+$/, '');
// CF Pages serves extensionless URLs (/x.html 308s to /x): canonical/og must
// name the final URL, not the redirect hop.
const cleanPath = path === '/index.html' ? '/' : path.replace(/\.html$/, '');
const canonical = `${ORIGIN}${cleanPath}`;
const ogImage = `${ORIGIN}/og.jpg`;
const ogT = ogTitle ?? title;
const ogD = ogDescription ?? description;

const NAV: [string, string, string][] = [
  ['board', '/index.html', 'board'],
  ['movers', '/movers.html', 'movers'],
  ['topics', '/topics.html', 'topics'],
  ['digests', '/digest.html', 'digests'],
  ['tools', '/tools/', 'tools'],
  ['about', '/about.html', 'about'],
];

const lds = jsonld ? (Array.isArray(jsonld) ? jsonld : [jsonld]) : [];
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script is:inline>
/* theme init before first paint — no FOUC */
try {
  var _t = new URLSearchParams(location.search).get('theme') ||
    localStorage.getItem('tsTheme');
  if (_t === 'dark' || _t === 'light') document.documentElement.dataset.theme = _t;
} catch (e) {}
</script>
<link rel="preconnect" href="https://fonts.bunny.net" crossorigin>
<link href="https://fonts.bunny.net/css?family=ibm-plex-sans:400,500,600,700|ibm-plex-mono:400,500,600|bricolage-grotesque:500,600,700&display=swap" rel="stylesheet">
<title>{title}</title>
{description && <meta name="description" content={description} />}
<link rel="canonical" href={canonical}>
{keywords && <meta name="keywords" content={keywords}>}
<meta property="og:title" content={ogT}>
<meta property="og:description" content={ogD}>
<meta property="og:type" content="website">
<meta property="og:url" content={canonical}>
<meta property="og:image" content={ogImage}>
<meta property="og:image:width" content="1536">
<meta property="og:image:height" content="1024">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={ogT}>
<meta name="twitter:description" content={ogD}>
<meta name="twitter:image" content={ogImage}>
<script is:inline src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>
<script is:inline src="/js/srcname.js"></script>
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>📡</text></svg>">
<link rel="search" type="application/opensearchdescription+xml" title="trendscope" href="/opensearch.xml">
<link rel="manifest" href="/manifest.json">
<meta name="theme-color" content="#0d1117">
<link rel="alternate" type="application/rss+xml" title="trendscope snapshots" href="/feed.xml">
<link rel="alternate" type="application/feed+json" title="trendscope snapshots" href="/feed.json">
{lds.map((ld) => <script type="application/ld+json" set:html={JSON.stringify(ld)} />)}
<!-- Cloudflare Web Analytics -->
<script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "3114a02fcbf84a80ba7f4258b80a82f9"}'></script>
<slot name="head" />
</head>
<body>
{!bare && <a class="skiplink" href={skipTo}>skip to content</a>}
{!bare && (
<header class="topbar">
  <a class="brand" href="/index.html"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/><line x1="12" y1="12" x2="19.5" y2="4.5"/></svg>trend<span class="scope">scope</span></a>
  <nav>
    {NAV.map(([key, href, label]) => (
      <a href={href} class={nav === key ? 'here' : undefined}>{label}</a>
    ))}
  </nav>
  <div class="right">
    <a href="/search.html" class={nav === 'search' ? 'here' : undefined}>search 19y of HN</a>
    <a href="/zh.html" class={nav === 'zh' ? 'here' : undefined}>中文</a>
    <a href="/feed.xml"><i data-lucide="rss"></i> subscribe</a>
    <a href="https://github.com/zalize-com/trendscope"><i data-lucide="star"></i> github</a>
    <button class="theme-toggle" type="button" aria-label="toggle dark mode" title="toggle theme"></button>
  </div>
</header>
)}
<slot />
<slot name="scripts" />
<script is:inline>
  if (window.lucide) lucide.createIcons();
  /* theme toggle: manual override beats OS preference, persists */
  (function () {
    var b = document.querySelector('.theme-toggle');
    if (!b) return;
    var SUN = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>';
    var MOON = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>';
    function cur() {
      return document.documentElement.dataset.theme ||
        (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
    }
    function paint() { b.innerHTML = cur() === 'dark' ? SUN : MOON; }
    b.addEventListener('click', function () {
      var next = cur() === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      try { localStorage.setItem('tsTheme', next); } catch (e) {}
      paint();
    });
    paint();
  })();
</script>
</body>
</html>
